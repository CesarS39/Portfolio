---
import Layout from "../../layouts/Layout.astro";
import HeroTitle from "../../components/atoms/HeroTitle.astro";
import BaseSection from "../../components/atoms/BaseSection.astro";

const techStack = [
  {
    name: "Regresión Lineal Simple",
    icon: "chart",
    description: "Algoritmo de machine learning",
    gradient: "from-neutral-800 to-neutral-800"
  },
  {
    name: "Vanilla JavaScript",
    icon: "sparkles",
    description: "Lógica frontend sin frameworks",
    gradient: "from-neutral-800 to-neutral-800"
  },
  {
    name: "TailwindCSS",
    icon: "palette",
    description: "Diseño responsivo moderno",
    gradient: "from-neutral-800 to-neutral-800"
  },
  {
    name: "SNIIM Data",
    icon: "database",
    description: "Datos oficiales mexicanos",
    gradient: "from-neutral-800 to-neutral-800"
  }
];

const features = [
  {
    title: "Modelo Estadístico Robusto",
    description: "Algoritmo de regresión lineal con R² = 0.939, entrenado con 1,119 registros del SNIIM de enero-julio 2025",
    icon: "chart",
    gradient: "from-neutral-800 to-neutral-800",
    details: [
      "Coeficiente R² = 0.939",
      "1,119 registros SNIIM",
      "Periodo: enero a julio de 2025",
      "Regresión lineal simple"
    ]
  },
  {
    title: "Interfaz de estimación",
    description: "Herramienta web para consultar una estimación a partir del peso del ganado ingresado",
    icon: "globe",
    gradient: "from-neutral-800 to-neutral-800",
    details: [
      "Interfaz web",
      "Diseño adaptable",
      "Estimación por peso ingresado",
      "Consulta de referencia"
    ]
  },
  {
    title: "Cálculo Instantáneo",
    description: "Estimación del precio total del ganado en tiempo real basada en el peso ingresado por el usuario",
    icon: "sparkles",
    gradient: "from-neutral-800 to-neutral-800",
    details: [
      "Respuesta inmediata",
      "Algoritmo optimizado",
      "Interfaz intuitiva",
      "Resultados precisos"
    ]
  },
  {
    title: "Metodología visible",
    description: "El proyecto presenta la ecuación de regresión y el conjunto de datos usado como referencia",
    icon: "search",
    gradient: "from-neutral-800 to-neutral-800",
    details: [
      "Algoritmo explicable",
      "Metodología transparente",
      "Metodología clara",
      "Disclaimers incluidos"
    ]
  }
];

const regressionDetails = [
  {
    concept: "Ecuación del Modelo",
    formula: "Precio = 102.53 × Peso_canal + 3,774.92",
    explanation: "Pendiente por peso dentro del modelo ajustado; la relación no garantiza precios futuros."
  },
  {
    concept: "Coeficiente de Determinación",
    formula: "R² = 0.939",
    explanation: "El modelo explica el 93.9% de la variabilidad en los precios"
  },
  {
    concept: "Intercepto",
    formula: "b = 3,774.92",
    explanation: "Valor estimado por la ecuación cuando el peso es cero."
  }
];


import Icon from "../../components/atoms/Icon.astro";
---

<Layout title="MiGanado | Estimación de precio de ganado" description="Calculadora de referencia para estimar precios de ganado bovino mediante regresión lineal y datos del SNIIM.">
  <HeroTitle text="MIGANADO" />

  <!-- Hero Section -->
  <BaseSection className="text-center py-20 !max-w-5xl">
    <div class="max-w-4xl mx-auto">
      <p class="text-xl text-neutral-300 max-w-3xl mx-auto leading-relaxed mb-8">
        Calculadora inteligente para la estimación del precio de ganado bovino utilizando
        regresión lineal simple basada en datos oficiales del SNIIM.
      </p>

      <!-- Tech Stack Pills -->
      <div class="flex flex-wrap justify-center gap-3 mb-10">
        <span class="px-4 py-2 bg-neutral-800 from-neutral-800 to-neutral-800 rounded-full text-sm font-semibold text-white hover:from-neutral-800 hover:to-neutral-800 hover:scale-105 transition-all duration-300 shadow-lg hover:shadow-black/20">
          Machine Learning
        </span>
        <span class="px-4 py-2 bg-neutral-800 from-neutral-800 to-neutral-800 rounded-full text-sm font-semibold text-white hover:from-neutral-800 hover:to-neutral-800 hover:scale-105 transition-all duration-300 shadow-lg hover:shadow-black/20">
          JavaScript
        </span>
        <span class="px-4 py-2 bg-neutral-800 from-neutral-800 to-neutral-800 rounded-full text-sm font-semibold text-white hover:from-neutral-800 hover:to-neutral-800 hover:scale-105 transition-all duration-300 shadow-lg hover:shadow-black/20">
          TailwindCSS
        </span>
        <span class="px-4 py-2 bg-neutral-800 from-neutral-800 to-neutral-800 rounded-full text-sm font-semibold text-white hover:from-neutral-800 hover:to-neutral-800 hover:scale-105 transition-all duration-300 shadow-lg hover:shadow-black/20">
          Datos SNIIM
        </span>
      </div>

    </div>
  </BaseSection>

  <!-- Problem Solution Section -->
  <BaseSection className="!max-w-5xl">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold mb-6 text-neutral-100">
          Democratizando la Información Ganadera
        </h2>
        <div class="w-24 h-1 bg-neutral-800 from-neutral-800 to-neutral-800 mx-auto mb-8"></div>
      </div>

      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="space-y-6">
          <div class="bg-white/5 border border-white/15 rounded-xl p-6 hover:bg-white/5 hover:border-white/15 hover:scale-105 transition-all duration-300 group">
            <h3 class="text-xl font-bold text-neutral-200 mb-4 group-hover:text-neutral-300 transition-colors"><Icon name="x" size={22} /> Problema Identificado</h3>
            <ul class="text-neutral-300 space-y-3 text-sm group-hover:text-neutral-200 transition-colors">
              <li class="flex items-start space-x-2">
                <span class="text-neutral-200 mt-1">•</span>
                <span>Asimetría de información en el sector ganadero</span>
              </li>
              <li class="flex items-start space-x-2">
                <span class="text-neutral-200 mt-1">•</span>
                <span>Dependencia de intermediarios para conocer precios</span>
              </li>
              <li class="flex items-start space-x-2">
                <span class="text-neutral-200 mt-1">•</span>
                <span>Falta de acceso a herramientas de valoración</span>
              </li>
              <li class="flex items-start space-x-2">
                <span class="text-neutral-200 mt-1">•</span>
                <span>Riesgo de negociar por debajo del precio justo</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="space-y-6">
          <div class="bg-white/5 border border-white/15 rounded-xl p-6 hover:bg-white/5 hover:border-white/15 hover:scale-105 transition-all duration-300 group">
            <h3 class="text-xl font-bold text-neutral-200 mb-4 group-hover:text-neutral-300 transition-colors"><Icon name="check" size={22} /> Solución MiGanado</h3>
            <ul class="text-neutral-300 space-y-3 text-sm group-hover:text-neutral-200 transition-colors">
              <li class="flex items-start space-x-2">
                <span class="text-neutral-200 mt-1">•</span>
                <span>Herramienta gratuita y accesible</span>
              </li>
              <li class="flex items-start space-x-2">
                <span class="text-neutral-200 mt-1">•</span>
                <span>Estimación basada en datos oficiales</span>
              </li>
              <li class="flex items-start space-x-2">
                <span class="text-neutral-200 mt-1">•</span>
                <span>Cálculo instantáneo y transparente</span>
              </li>
              <li class="flex items-start space-x-2">
                <span class="text-neutral-200 mt-1">•</span>
                <span>Empoderamiento del productor ganadero</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </BaseSection>

  <!-- Tech Stack & AI Model -->
  <BaseSection className="!max-w-5xl">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold mb-6 text-neutral-100">
        Inteligencia Artificial Aplicada
      </h2>
      <div class="w-24 h-1 bg-neutral-800 from-neutral-800 to-neutral-800 mx-auto mb-8"></div>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto mb-16">
      {techStack.map((tech) => (
        <div class="group bg-neutral-800 from-neutral-800 to-neutral-900 rounded-2xl p-6 border border-neutral-700 hover:border-white/15 hover:scale-110 hover:-translate-y-2 transition-all duration-500 hover:shadow-2xl hover:shadow-black/20">
          <div class="text-4xl mb-4 text-center group-hover:scale-125 group-hover:rotate-6 transition-all duration-500">
            <Icon name={tech.icon} size={38} class="project-icon" />
          </div>
          <h3 class="text-lg font-bold text-center mb-2 text-white group-hover:text-neutral-200 transition-colors duration-300">
            {tech.name}
          </h3>
          <p class="text-neutral-400 text-sm text-center group-hover:text-neutral-300 transition-colors duration-300">
            {tech.description}
          </p>
          <div class={`mt-4 h-1 rounded bg-neutral-800 ${tech.gradient} mx-auto w-0 group-hover:w-full transition-all duration-500`}></div>
        </div>
      ))}
    </div>

    <!-- Regression Model Details -->
    <div class="bg-neutral-800 from-neutral-800/50 to-neutral-900/50 rounded-2xl p-8 border border-neutral-700 hover:border-white/15 hover:shadow-xl hover:shadow-black/20 transition-all duration-300">
      <h3 class="text-2xl font-bold text-center mb-8 text-neutral-200">Modelo de Regresión Lineal Simple</h3>
      <div class="grid md:grid-cols-3 gap-8">
        {regressionDetails.map((detail) => (
          <div class="text-center bg-neutral-700/50 rounded-xl p-6 hover:bg-neutral-700/70 hover:scale-105 transition-all duration-300 group">
            <h4 class="font-semibold text-white mb-3 group-hover:text-neutral-200 transition-colors">{detail.concept}</h4>
            <div class="font-mono text-neutral-200 font-bold text-lg mb-3 group-hover:text-neutral-300 transition-colors">
              {detail.formula}
            </div>
            <p class="text-neutral-300 text-sm group-hover:text-neutral-200 transition-colors">
              {detail.explanation}
            </p>
          </div>
        ))}
      </div>
    </div>
  </BaseSection>

  <!-- Features Section -->
  <BaseSection className="!max-w-5xl">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold mb-6 text-neutral-100">
        Características Principales
      </h2>
      <div class="w-24 h-1 bg-neutral-800 from-neutral-800 to-neutral-800 mx-auto mb-8"></div>
    </div>

    <div class="grid lg:grid-cols-2 gap-8 max-w-6xl mx-auto">
      {features.map((feature, index) => (
        <div class="group relative bg-neutral-800 from-neutral-800 to-neutral-900 rounded-2xl p-8 border border-neutral-700 hover:border-white/15 hover:scale-105 hover:-translate-y-2 transition-all duration-500 overflow-hidden hover:shadow-2xl hover:shadow-black/20">
          <div class={`absolute inset-0 bg-neutral-800 ${feature.gradient} opacity-0 group-hover:opacity-15 transition-opacity duration-500`}></div>

          <div class="relative z-10">
            <div class="flex items-start space-x-4 mb-6">
              <div class="text-4xl group-hover:scale-125 group-hover:rotate-12 transition-all duration-500">
                <Icon name={feature.icon} size={38} class="project-icon" />
              </div>
              <div class="flex-1">
                <h3 class="text-xl font-bold mb-3 text-white group-hover:text-neutral-200 transition-colors duration-300">
                  {feature.title}
                </h3>
                <p class="text-neutral-300 leading-relaxed mb-4 group-hover:text-neutral-200 transition-colors duration-300">
                  {feature.description}
                </p>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-2">
              {feature.details.map((detail) => (
                <div class="flex items-center space-x-2 text-sm text-neutral-400 group-hover:text-neutral-300 transition-colors duration-300">
                  <div class="w-1.5 h-1.5 bg-neutral-700 rounded-full group-hover:bg-neutral-700 transition-colors"></div>
                  <span>{detail}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </BaseSection>

  <BaseSection className="!max-w-5xl">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-3xl font-bold mb-6">Datos del modelo</h2>
      <p class="text-neutral-300 leading-relaxed">
        El proyecto reporta un coeficiente de determinación R² = 0.939 para una
        regresión lineal simple basada en 1,119 registros del SNIIM recopilados
        entre enero y julio de 2025. R² describe el ajuste del modelo a esos datos;
        no representa una garantía de precisión para precios futuros.
      </p>
    </div>
  </BaseSection>

  <!-- Technical Implementation -->
  <BaseSection className="!max-w-5xl">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold mb-6 text-neutral-100">
        Implementación Técnica
      </h2>
      <div class="w-24 h-1 bg-neutral-800 from-neutral-800 to-neutral-800 mx-auto mb-8"></div>
    </div>

    <div class="max-w-5xl mx-auto">
      <div class="grid md:grid-cols-2 gap-8 mb-12">
        <!-- Data Source -->
        <div class="bg-neutral-800 from-neutral-800 to-neutral-900 rounded-2xl p-8 border border-neutral-700 hover:border-white/15 hover:scale-105 transition-all duration-300 group hover:shadow-xl hover:shadow-black/20">
          <div class="text-center mb-6">
            <div class="text-4xl mb-3 group-hover:scale-110 group-hover:rotate-6 transition-all duration-300"><Icon name="database" size={22} /></div>
            <h3 class="text-xl font-bold text-white mb-2 group-hover:text-neutral-200 transition-colors">Fuente de Datos</h3>
            <p class="text-neutral-400 text-sm group-hover:text-neutral-300 transition-colors">Sistema Nacional de Información (SNIIM)</p>
          </div>

          <div class="space-y-4">
            <div class="bg-neutral-700/50 rounded-lg p-4 hover:bg-neutral-700/70 transition-colors duration-300 group/item">
              <h4 class="font-semibold text-neutral-200 mb-2 group-hover/item:text-neutral-300 transition-colors"><Icon name="chart" size={22} /> Dataset Utilizado</h4>
              <p class="text-neutral-300 text-sm group-hover/item:text-neutral-200 transition-colors">1,119 registros de ganado bovino en canal (enero-julio 2025)</p>
            </div>

            <div class="bg-neutral-700/50 rounded-lg p-4 hover:bg-neutral-700/70 transition-colors duration-300 group/item">
              <h4 class="font-semibold text-neutral-200 mb-2 group-hover/item:text-neutral-300 transition-colors"><Icon name="target" size={22} /> Variables del Modelo</h4>
              <p class="text-neutral-300 text-sm group-hover/item:text-neutral-200 transition-colors">Variable X: Peso en canal (kg) | Variable Y: Precio total (MXN)</p>
            </div>
          </div>
        </div>

        <!-- Algorithm -->
        <div class="bg-neutral-800 from-neutral-800 to-neutral-900 rounded-2xl p-8 border border-neutral-700 hover:border-white/15 hover:scale-105 transition-all duration-300 group hover:shadow-xl hover:shadow-black/20">
          <div class="text-center mb-6">
            <div class="text-4xl mb-3 group-hover:scale-110 group-hover:rotate-6 transition-all duration-300"><Icon name="cpu" size={22} /></div>
            <h3 class="text-xl font-bold text-white mb-2 group-hover:text-neutral-200 transition-colors">Algoritmo de ML</h3>
            <p class="text-neutral-400 text-sm group-hover:text-neutral-300 transition-colors">Regresión Lineal Simple optimizada</p>
          </div>

          <div class="space-y-4">
            <div class="bg-neutral-700/50 rounded-lg p-4 hover:bg-neutral-700/70 transition-colors duration-300 group/item">
              <h4 class="font-semibold text-neutral-200 mb-2 group-hover/item:text-neutral-300 transition-colors"><Icon name="chart" size={22} /> Método de Mínimos Cuadrados</h4>
              <p class="text-neutral-300 text-sm group-hover/item:text-neutral-200 transition-colors">Encuentra la línea que minimiza la suma de errores cuadráticos</p>
            </div>

            <div class="bg-neutral-700/50 rounded-lg p-4 hover:bg-neutral-700/70 transition-colors duration-300 group/item">
              <h4 class="font-semibold text-neutral-200 mb-2 group-hover/item:text-neutral-300 transition-colors"><Icon name="sparkles" size={22} /> Implementación JavaScript</h4>
              <p class="text-neutral-300 text-sm group-hover/item:text-neutral-200 transition-colors">Cálculo directo en el frontend sin dependencias externas</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Code Implementation -->
      <div class="bg-neutral-800 from-neutral-800/50 to-neutral-900/50 rounded-2xl p-8 border border-neutral-700 hover:border-white/15 hover:shadow-xl hover:shadow-black/20 transition-all duration-300 group">
        <h3 class="text-2xl font-bold text-center mb-8 text-neutral-200 group-hover:text-neutral-300 transition-colors">Implementación del Algoritmo</h3>

        <div class="bg-neutral-900 rounded-xl p-6 border border-neutral-700 hover:border-white/15 transition-colors duration-300">
          <div class="flex items-center justify-between mb-4">
            <span class="text-sm text-neutral-400">JavaScript</span>
            <span class="text-xs text-neutral-500">Función de predicción</span>
          </div>
          <pre class="text-sm text-neutral-300 overflow-x-auto"><code>{`// Parámetros del modelo de regresión lineal
const REGRESSION_SLOPE = 102.53;     // Pendiente (m)
const REGRESSION_INTERCEPT = 3774.92; // Intercepto (b)

// Función de predicción: y = mx + b
function calculateTotalPrice(weight) {
  return (REGRESSION_SLOPE * weight) + REGRESSION_INTERCEPT;
}

// Cálculo del precio por kilogramo
function calculatePricePerKg(totalPrice, weight) {
  return totalPrice / weight;
}`}</code></pre>
        </div>

        <div class="mt-6 text-center">
          <div class="inline-flex items-center space-x-2 px-4 py-2 bg-white/10 border border-white/15 rounded-lg hover:bg-white/10 hover:border-white/15 transition-all duration-300">
            <span class="text-xl"><Icon name="clipboard" size={22} /></span>
            <span class="text-neutral-200 text-sm">Implementación simple y eficiente</span>
          </div>
        </div>
      </div>
    </div>
  </BaseSection>

  <!-- Future Scalability -->
  <BaseSection className="!max-w-5xl">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold mb-6 text-neutral-100">
        Escalabilidad y Futuras Mejoras
      </h2>
      <div class="w-24 h-1 bg-neutral-800 from-neutral-800 to-neutral-800 mx-auto mb-8"></div>
    </div>

    <div class="max-w-4xl mx-auto">
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-neutral-800 from-neutral-800 to-neutral-900 rounded-2xl p-8 border border-neutral-700 hover:border-white/15 hover:scale-105 hover:-translate-y-2 transition-all duration-500 group hover:shadow-xl hover:shadow-black/20">
          <h3 class="text-xl font-bold text-neutral-200 mb-6 group-hover:text-neutral-300 transition-colors"><Icon name="sparkles" size={22} /> Mejoras Técnicas</h3>
          <div class="space-y-4">
            <div class="flex items-start space-x-3 group/item hover:scale-105 transition-transform duration-300">
              <div class="w-2 h-2 bg-neutral-700 rounded-full mt-2 flex-shrink-0 group-hover/item:bg-neutral-700 transition-colors"></div>
              <p class="text-neutral-300 text-sm group-hover/item:text-neutral-200 transition-colors">Modelo multivariable (raza, región, edad)</p>
            </div>
            <div class="flex items-start space-x-3 group/item hover:scale-105 transition-transform duration-300">
              <div class="w-2 h-2 bg-neutral-700 rounded-full mt-2 flex-shrink-0 group-hover/item:bg-neutral-700 transition-colors"></div>
              <p class="text-neutral-300 text-sm group-hover/item:text-neutral-200 transition-colors">API para integración con otros sistemas</p>
            </div>
            <div class="flex items-start space-x-3 group/item hover:scale-105 transition-transform duration-300">
              <div class="w-2 h-2 bg-neutral-700 rounded-full mt-2 flex-shrink-0 group-hover/item:bg-neutral-700 transition-colors"></div>
              <p class="text-neutral-300 text-sm group-hover/item:text-neutral-200 transition-colors">Base de datos en tiempo real</p>
            </div>
            <div class="flex items-start space-x-3 group/item hover:scale-105 transition-transform duration-300">
              <div class="w-2 h-2 bg-neutral-700 rounded-full mt-2 flex-shrink-0 group-hover/item:bg-neutral-700 transition-colors"></div>
              <p class="text-neutral-300 text-sm group-hover/item:text-neutral-200 transition-colors">Machine Learning más avanzado</p>
            </div>
          </div>
        </div>

        <div class="bg-neutral-800 from-neutral-800 to-neutral-900 rounded-2xl p-8 border border-neutral-700 hover:border-white/15 hover:scale-105 hover:-translate-y-2 transition-all duration-500 group hover:shadow-xl hover:shadow-black/20">
          <h3 class="text-xl font-bold text-neutral-200 mb-6 group-hover:text-neutral-300 transition-colors"><Icon name="rocket" size={22} /> Expansión del Negocio</h3>
          <div class="space-y-4">
            <div class="flex items-start space-x-3 group/item hover:scale-105 transition-transform duration-300">
              <div class="w-2 h-2 bg-neutral-700 rounded-full mt-2 flex-shrink-0 group-hover/item:bg-neutral-700 transition-colors"></div>
              <p class="text-neutral-300 text-sm group-hover/item:text-neutral-200 transition-colors">Otros tipos de ganado (porcino, ovino)</p>
            </div>
            <div class="flex items-start space-x-3 group/item hover:scale-105 transition-transform duration-300">
              <div class="w-2 h-2 bg-neutral-700 rounded-full mt-2 flex-shrink-0 group-hover/item:bg-neutral-700 transition-colors"></div>
              <p class="text-neutral-300 text-sm group-hover/item:text-neutral-200 transition-colors">Mercados agrícolas adicionales</p>
            </div>
            <div class="flex items-start space-x-3 group/item hover:scale-105 transition-transform duration-300">
              <div class="w-2 h-2 bg-neutral-700 rounded-full mt-2 flex-shrink-0 group-hover/item:bg-neutral-700 transition-colors"></div>
              <p class="text-neutral-300 text-sm group-hover/item:text-neutral-200 transition-colors">Plataforma integral para productores</p>
            </div>
            <div class="flex items-start space-x-3 group/item hover:scale-105 transition-transform duration-300">
              <div class="w-2 h-2 bg-neutral-700 rounded-full mt-2 flex-shrink-0 group-hover/item:bg-neutral-700 transition-colors"></div>
              <p class="text-neutral-300 text-sm group-hover/item:text-neutral-200 transition-colors">Expansión internacional</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </BaseSection>

  <!-- CTA Section -->
  <BaseSection className="text-center !max-w-5xl">
    <div class="bg-neutral-800 from-neutral-800 to-neutral-900 rounded-2xl p-12 border border-neutral-700 hover:border-white/15 hover:shadow-2xl hover:shadow-black/20 transition-all duration-500 group">
      <h2 class="text-3xl font-bold mb-6 text-neutral-100 group-hover:from-neutral-800 group-hover:to-neutral-800 transition-all duration-300">
        Tecnología al Servicio del Campo
      </h2>
      <p class="text-neutral-300 mb-8 max-w-2xl mx-auto group-hover:text-neutral-200 transition-colors duration-300">
        MiGanado demuestra que la inteligencia artificial puede y debe servir a todos los sectores de nuestra sociedad.
        Una herramienta que busca democratizar el acceso a la información y empoderar al productor ganadero.
      </p>

      <!-- Project summary -->
      <div class="mt-8 pt-8 border-t border-neutral-700 group-hover:border-white/15 transition-colors duration-300">
        <p class="text-neutral-400 text-sm group-hover:text-neutral-300 transition-colors duration-300">
