---
const skills = [
  {
    name: "Inglés",
    detail: "B2 — documentación técnica y comunicación profesional",
  },
  {
    name: "Trabajo en equipo",
    detail: "Adaptación a distintos roles dentro de un equipo de desarrollo",
  },
  {
    name: "Organización",
    detail: "Gestión de tiempos y cumplimiento consistente de entregas",
  },
  {
    name: "Resolución de problemas",
    detail: "Análisis sistemático y búsqueda de soluciones efectivas",
  },
  {
    name: "Comunicación",
    detail: "Claridad técnica y habilidades de presentación y oratoria",
  },
  {
    name: "Aprendizaje autónomo",
    detail: "Exploración continua de nuevas tecnologías y metodologías",
  },
];
---

<section id="habilidades" class="reveal-section skills-section">
  <div class="skills-inner">

    <div class="skills-header">
      <p class="skills-label">Competencias</p>
      <h2 class="skills-heading">Habilidades blandas</h2>
    </div>

    <ul class="skills-list">
      {skills.map((skill) => (
        <li class="skills-item">
          <span class="skills-name">{skill.name}</span>
          <span class="skills-detail">{skill.detail}</span>
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
  .skills-section {
    padding: clamp(4.5rem, 9vw, 7.5rem) var(--page-gutter);
    background: var(--bg);
  }

  .skills-inner {
    max-width: 56rem;
    margin: 0 auto;
  }

  /* ── Header ── */
  .skills-label {
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .skills-heading {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 2rem;
  }

  /* ── List ── */
  .skills-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .skills-item {
    display: grid;
    grid-template-columns: 1fr minmax(12rem, auto);
    align-items: baseline;
    gap: 1.25rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--line);
    transition: border-color 0.2s ease;
  }

  .skills-item:first-child {
    border-top: 1px solid var(--line);
  }

  .skills-item:hover {
    border-bottom-color: var(--accent-strong);
  }

  .skills-name {
    font-family: 'Syne', sans-serif;
    font-weight: 600;
    font-size: 1rem;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .skills-detail {
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    color: var(--muted);
    text-align: right;
    max-width: 24rem;
    line-height: 1.5;
  }

  /* ── Mobile ── */
  @media (max-width: 640px) {
    .skills-item {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
    }

    .skills-detail {
      grid-column: 1;
      text-align: left;
      color: var(--muted);
    }
  }
</style>
