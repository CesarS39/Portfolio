---
import HeroScene from "./3d/HeroScene.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__canvas" aria-hidden="true"><HeroScene /></div>
  <div class="hero__shade" aria-hidden="true"></div>
  <div class="hero__content">
    <p class="hero__eyebrow">Desarrollador de software · Pachuca, Hidalgo</p>
    <h1 id="hero-title" class="hero__name">César<br />Enríquez</h1>
    <p class="hero__sub">Diseño y construyo productos digitales, aplicaciones móviles y sistemas empresariales.</p>
    <div class="hero__cta">
      <a href="#projects" class="btn-primary">Explorar proyectos</a>
      <a href="#contact" class="btn-ghost">Contactarme</a>
    </div>
  </div>
  <a class="hero__scroll" href="#sobre-mi" aria-label="Continuar al perfil">
    <span aria-hidden="true">↓</span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(900px, 100svh);
    min-height: max(42rem, 100svh);
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--bg);
  }
  .hero__canvas { position: absolute; inset: 0; z-index: 0; opacity: .76; }
  .hero__canvas > * { width: 100% !important; height: 100% !important; }
  .hero__shade {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(90deg, rgba(9,19,41,.94) 2%, rgba(9,19,41,.68) 42%, rgba(9,19,41,.04) 100%),
      linear-gradient(0deg, var(--bg), transparent 30%);
  }
  .hero__content {
    position: relative; z-index: 2; width: min(100%, 100rem); margin: 0 auto;
    padding: 7rem var(--page-gutter) 5rem; pointer-events: none;
  }
  .hero__eyebrow {
    margin: 0 0 1.4rem; color: var(--muted); font-size: .78rem;
    letter-spacing: .03em;
  }
  .hero__name {
    width: fit-content; margin: 0 0 1.5rem; color: var(--text);
    font-size: clamp(4.5rem, 12vw, 10.75rem); font-weight: 700;
    line-height: .79; letter-spacing: -.085em;
  }
  .hero__sub { max-width: 33rem; margin: 0 0 2rem; color: var(--muted); font-size: clamp(1rem, 1.7vw, 1.2rem); line-height: 1.65; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: .75rem; pointer-events: auto; }
  .btn-primary, .btn-ghost {
    display: inline-flex; min-height: 2.9rem; align-items: center; justify-content: center;
    padding: .75rem 1.2rem; border: 1px solid var(--line); border-radius: var(--radius);
    font: 600 .84rem Syne, sans-serif; text-decoration: none;
    transition: background-color .18s ease, border-color .18s ease, color .18s ease;
  }
  .btn-primary { background: var(--accent); color: var(--bg); border-color: var(--accent); }
  .btn-primary:hover { background: #fff; border-color: #fff; }
  .btn-ghost { background: rgba(9,19,41,.45); color: var(--text); }
  .btn-ghost:hover { background: rgba(255,255,255,.08); border-color: rgba(255,255,255,.3); }
  .hero__scroll {
    position: absolute; right: var(--page-gutter); bottom: 2.5rem; z-index: 2;
    display: grid; width: 2.8rem; height: 2.8rem; place-items: center;
    border: 1px solid var(--line); border-radius: 50%; color: var(--muted); text-decoration: none;
  }
  .hero__scroll:hover { color: var(--text); border-color: var(--accent-strong); }
  @media (max-width: 640px) {
    .hero { min-height: 44rem; min-height: 100svh; }
    .hero__shade { background: linear-gradient(90deg, rgba(9,19,41,.88), rgba(9,19,41,.56)), linear-gradient(0deg, var(--bg), transparent 40%); }
    .hero__name { font-size: clamp(4.1rem, 20vw, 7rem); }
    .hero__scroll { right: var(--page-gutter); bottom: 1.5rem; }
  }
  @media (prefers-reduced-motion: reduce) { .hero__canvas { opacity: .28; } }
</style>
