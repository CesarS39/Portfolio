---
const {
  title,
  description,
  image,
  link,
  techStack = [],
  featured = false,
  demo,
} = Astro.props;

const projectHref = link;
---

<article class:list={["project-card", { "project-card--featured": featured }]}>
  {projectHref ? (
    <a class="project-card__image-link" href={projectHref} aria-label={`Ver caso de estudio: ${title}`}>
      <img loading="lazy" src={image} alt={`Captura de ${title}`} width="960" height="600" />
      <span class="project-card__open">Ver caso de estudio <span aria-hidden="true">↗</span></span>
    </a>
  ) : (
    <div class="project-card__image-link">
      <img loading="lazy" src={image} alt={`Captura de ${title}`} width="960" height="600" />
    </div>
  )}
  <div class="project-card__body">
    <div class="project-card__title-row">
      <h3>{title}</h3>
      {techStack.length > 0 && (
        <ul class="project-card__tech" aria-label="Tecnologías">
          {techStack.map((tech: string) => <li>{tech}</li>)}
        </ul>
      )}
    </div>
    <p>{description}</p>
    <div class="project-card__actions">
      {demo && <a href={demo} target="_blank" rel="noopener noreferrer">Abrir demo <span aria-hidden="true">↗</span></a>}
    </div>
  </div>
</article>

<style>
  .project-card { min-width: 0; overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  .project-card__image-link { position: relative; display: block; overflow: hidden; background: var(--surface-raised); aspect-ratio: 16 / 9; color: var(--text); text-decoration: none; }
  .project-card__image-link img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top center; transition: transform .28s ease, filter .28s ease; }
  .project-card__image-link:hover img, .project-card__image-link:focus-visible img { transform: scale(1.025); filter: brightness(.72); }
  .project-card__open { position: absolute; right: 1rem; bottom: 1rem; padding: .55rem .75rem; border: 1px solid rgba(255,255,255,.28); border-radius: var(--radius); background: rgba(9,19,41,.82); font-size: .76rem; font-weight: 600; opacity: 0; transform: translateY(.3rem); transition: opacity .18s ease, transform .18s ease; }
  .project-card__image-link:hover .project-card__open, .project-card__image-link:focus-visible .project-card__open { opacity: 1; transform: translateY(0); }
  .project-card__body { padding: 1.1rem 1.15rem 1.2rem; }
  .project-card__title-row { display: flex; align-items: baseline; justify-content: space-between; gap: .85rem; }
  .project-card h3 { margin: 0; font-size: clamp(1.05rem, 2vw, 1.3rem); letter-spacing: -.035em; line-height: 1.3; }
  .project-card__body > p { max-width: 55ch; margin: .6rem 0 .9rem; color: var(--muted); font-size: .88rem; line-height: 1.6; }
  .project-card__tech { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .35rem; margin: 0; padding: 0; list-style: none; }
  .project-card__tech li { padding: .2rem .45rem; border: 1px solid var(--line); border-radius: 2px; color: var(--muted); font-size: .68rem; white-space: nowrap; }
  .project-card__actions { display: flex; flex-wrap: wrap; gap: 1rem; }
  .project-card__actions a { min-height: 2.5rem; display: inline-flex; align-items: center; gap: .4rem; color: var(--accent); font-size: .78rem; font-weight: 600; text-decoration: none; }
  .project-card__actions a:hover { color: #fff; }
  @media (max-width: 500px) {
    .project-card__title-row { align-items: flex-start; flex-direction: column; }
    .project-card__tech { justify-content: flex-start; }
    .project-card__open { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) { .project-card__image-link img { transition: none; } }
</style>
