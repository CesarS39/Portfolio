---
interface ContactIcon { href: string; icon: string; title: string; bgColor?: string }
interface ContactData { name: string; location: string; role: string; prompt: string; image: string; icons: ContactIcon[] }
const { data } = Astro.props as { data: ContactData };
const email = data.icons.find((item) => item.title === "Email")?.href?.replace("mailto:", "") ?? "cesarsamuel37@gmail.com";
const socials = data.icons.filter((item) => item.title !== "Email");
---

<section id="contact" class="contact-section reveal-section" aria-labelledby="contact-title">
  <div class="contact-inner">
    <div class="contact-copy">
      <p class="contact-label">Contacto</p>
      <h2 id="contact-title">¿Construimos<br />algo útil?</h2>
      <p class="contact-location">{data.role} · {data.location}</p>
    </div>
    <div class="contact-links">
      <a class="contact-email" href={`mailto:${email}`}>{email}<span aria-hidden="true">↗</span></a>
      <button class="contact-copy-btn" id="contact-copy-btn" type="button">Copiar correo</button>
      <p class="contact-status" id="contact-copy-hint" aria-live="polite">También puedes encontrarme en</p>
      <div class="contact-socials">
        {socials.map((item) => (
          <a href={item.href} target="_blank" rel="noopener noreferrer" aria-label={item.title}>
            <img src={`${import.meta.env.BASE_URL}${item.icon.replace(/^\//, "")}`} alt="" width="20" height="20" loading="lazy" />
            <span>{item.title}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const copyButton = document.getElementById("contact-copy-btn");
  const status = document.getElementById("contact-copy-hint");
  copyButton?.addEventListener("click", async () => {
    const emailLink = document.querySelector<HTMLAnchorElement>(".contact-email");
    const address = emailLink?.getAttribute("href")?.replace("mailto:", "") ?? "";
    try {
      await navigator.clipboard.writeText(address);
      if (status) status.textContent = "Correo copiado al portapapeles.";
    } catch {
      if (status) status.textContent = `Copia esta dirección: ${address}`;
    }
  });
</script>

<style>
  .contact-section { padding: clamp(5rem, 11vw, 9rem) var(--page-gutter) 6rem; background: var(--surface); }
  .contact-inner { width: min(100%, var(--content-width)); margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 8vw, 7rem); align-items: end; }
  .contact-label { margin: 0 0 .8rem; color: var(--muted); font-size: .78rem; }
  .contact-copy h2 { margin: 0 0 1.2rem; font-size: clamp(3rem, 7vw, 6rem); line-height: .92; letter-spacing: -.075em; }
  .contact-location { margin: 0; color: var(--muted); font-size: .9rem; }
  .contact-links { display: flex; flex-direction: column; align-items: flex-start; }
  .contact-email { display: flex; align-items: center; justify-content: space-between; gap: 1rem; width: 100%; padding: 0 0 .8rem; border-bottom: 1px solid var(--line); font-size: clamp(1.1rem, 2.4vw, 1.8rem); text-decoration: none; overflow-wrap: anywhere; }
  .contact-email:hover { color: var(--accent-strong); }
  .contact-copy-btn { min-height: 2.75rem; margin-top: .6rem; padding: .55rem 0; border: 0; background: transparent; color: var(--muted); font: 500 .78rem Inter, sans-serif; cursor: pointer; }
  .contact-copy-btn:hover { color: var(--text); }
  .contact-status { margin: 1.3rem 0 .7rem; color: var(--quiet); font-size: .75rem; }
  .contact-socials { display: flex; flex-wrap: wrap; gap: .65rem; }
  .contact-socials a { display: inline-flex; min-height: 2.75rem; align-items: center; gap: .5rem; padding: .55rem .75rem; border: 1px solid var(--line); border-radius: var(--radius); color: var(--muted); font-size: .78rem; text-decoration: none; transition: color .18s ease, border-color .18s ease; }
  .contact-socials a:hover { color: var(--text); border-color: var(--accent-strong); }
  .contact-socials img { opacity: .95; }
  @media (max-width: 700px) { .contact-inner { grid-template-columns: 1fr; gap: 2.5rem; } }
</style>
