---
import Layout from "../../layouts/Layout.astro";
import GalleryComponent from "../../components/organisms/GalleryComponent.astro";
import HeroTitle from "../../components/atoms/HeroTitle.astro";
import BaseSection from "../../components/atoms/BaseSection.astro";

const screenshots = [
  { src: "/Portfolio/images/projects/notiontennis/main.webp", alt: "Panel principal de Notion Tennis" },
  { src: "/Portfolio/images/projects/notiontennis/Registro de asistencia.webp", alt: "Registro de asistencia" },
  { src: "/Portfolio/images/projects/notiontennis/estudiante.webp", alt: "Ficha del estudiante" },
  { src: "/Portfolio/images/projects/notiontennis/resumenfecha.webp", alt: "Resumen por fecha" },
  { src: "/Portfolio/images/projects/notiontennis/grafico1.webp", alt: "Estadísticas de asistencia" },
  { src: "/Portfolio/images/projects/notiontennis/grafico2.webp", alt: "Evolución de métricas" }
];

const techStack = [
  {
    name: "Notion",
    icon: "database",
    description: "Plataforma principal no-code"
  },
  {
    name: "Automation",
    icon: "sparkles",
    description: "Flujos de trabajo automáticos"
  },
  {
    name: "Templates",
    icon: "clipboard",
    description: "Plantillas personalizadas"
  },
  {
    name: "Analytics",
    icon: "chart",
    description: "Análisis de datos avanzado"
  }
];

const features = [
  {
    title: "Gestión de Asistencias Automatizada",
    description: "Sistema de pase de lista digital con seguimiento en tiempo real, notificaciones automáticas y reportes de participación estudiantil",
    icon: "check",
    gradient: "from-neutral-800 to-neutral-800"
  },
  {
    title: "Administración de Eventos",
    description: "Organización completa de torneos, entrenamientos y actividades especiales con calendario integrado y gestión de participantes",
    icon: "trophy",
    gradient: "from-neutral-800 to-neutral-800"
  },
  {
    title: "Sistema de Calificaciones",
    description: "Evaluación integral del rendimiento deportivo con métricas personalizadas y seguimiento del progreso individual",
    icon: "chart",
    gradient: "from-neutral-800 to-neutral-800"
  },
  {
    title: "Análisis Estadístico Avanzado",
    description: "Dashboard con KPIs clave, tendencias de participación y métricas para la toma de decisiones estratégicas",
    icon: "chart",
    gradient: "from-neutral-800 to-neutral-800"
  }
];
import Icon from "../../components/atoms/Icon.astro";
---

<Layout title="Notion Tennis UPP | Gestión deportiva universitaria" description="Sistema en Notion para organizar asistencia, eventos, evaluaciones y reportes de un programa deportivo universitario.">
  <HeroTitle text="NOTION TENNIS UPP" />
  <!-- Hero Section -->
  <BaseSection className="text-center py-20">
    
    <div class="mt-8">
      <p class="text-xl text-neutral-300 max-w-3xl mx-auto leading-relaxed">
        Sistemas no-code desarrollados durante el servicio social para optimizar la gestión del extracurricular de tenis 
        en la Universidad Politécnica de Pachuca, transformando procesos manuales en flujos automatizados eficientes.
      </p>
      <div class="flex flex-wrap justify-center gap-3 mt-8">
        <span class="px-4 py-2 bg-neutral-800 rounded-full text-sm font-semibold">
          Notion
        </span>
        <span class="px-4 py-2 bg-neutral-800 from-neutral-800 to-neutral-800 rounded-full text-sm font-semibold">
          No-Code
        </span>
        <span class="px-4 py-2 bg-neutral-800 from-neutral-800 to-neutral-800 rounded-full text-sm font-semibold">
          Automatización
        </span>
        <span class="px-4 py-2 bg-neutral-800 from-neutral-800 to-neutral-800 rounded-full text-sm font-semibold">
          Analytics
        </span>
      </div>
    </div>
  </BaseSection>

  <!-- Problem Solution Section -->
  <BaseSection>
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold mb-6 text-neutral-100">
          Modernizando la Gestión Deportiva Universitaria
        </h2>
        <div class="w-24 h-1 bg-neutral-800 from-neutral-800 to-neutral-800 mx-auto mb-8"></div>
      </div>
      
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="space-y-6">
          <div class="bg-white/5 border border-white/15 rounded-xl p-6">
            <h3 class="text-xl font-bold text-neutral-200 mb-3"><Icon name="x" size={22} /> Situación Anterior</h3>
            <ul class="text-neutral-300 space-y-2">
              <li>• Pase de lista manual con papel</li>
              <li>• Registro desorganizado de eventos</li>
              <li>• Calificaciones en hojas dispersas</li>
              <li>• Sin análisis de datos ni métricas</li>
              <li>• Toma de decisiones sin base estadística</li>
            </ul>
          </div>
        </div>
        
        <div class="space-y-6">
          <div class="bg-white/5 border border-white/15 rounded-xl p-6">
            <h3 class="text-xl font-bold text-neutral-200 mb-3"><Icon name="check" size={22} /> Solución No-Code</h3>
            <ul class="text-neutral-300 space-y-2">
              <li>• Sistema digital automatizado</li>
              <li>• Gestión centralizada de información</li>
              <li>• Reportes automáticos en tiempo real</li>
              <li>• Dashboard con métricas clave</li>
              <li>• Decisiones basadas en datos</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </BaseSection>

  <!-- Tech Stack Destacado -->
  <BaseSection>
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold mb-6 text-neutral-100">
        Stack No-Code Especializado
      </h2>
      <div class="w-24 h-1 bg-neutral-800 from-neutral-800 to-neutral-800 mx-auto mb-8"></div>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
      {techStack.map((tech) => (
        <div class="group bg-neutral-800 from-neutral-800 to-neutral-900 rounded-2xl p-6 border border-neutral-700 hover:border-white/15 hover:scale-105 transition-all duration-300">
          <div class="text-4xl mb-4 text-center group-hover:scale-110 transition-transform">
            <Icon name={tech.icon} size={38} class="project-icon" />
          </div>
          <h3 class="text-lg font-bold text-center mb-2 text-white">
            {tech.name}
          </h3>
          <p class="text-neutral-400 text-sm text-center">
            {tech.description}
          </p>
        </div>
      ))}
    </div>

    <!-- Detalles técnicos expandidos -->
    <div class="mt-12 bg-neutral-800 from-neutral-800/50 to-neutral-900/50 rounded-2xl p-8 border border-neutral-700">
      <h3 class="text-2xl font-bold text-center mb-8 text-neutral-200">Componentes & Funcionalidades</h3>
      <div class="grid md:grid-cols-3 gap-8 text-center">
        <div>
          <h4 class="font-semibold text-white mb-3">Gestión de Datos</h4>
          <div class="text-neutral-300 space-y-1">
            <p>Bases de datos relacionales</p>
            <p>Formularios personalizados</p>
            <p>Validación de datos automática</p>
            <p>Backup y sincronización</p>
          </div>
        </div>
        <div>
          <h4 class="font-semibold text-white mb-3">Automatización</h4>
          <div class="text-neutral-300 space-y-1">
            <p>Flujos de trabajo automáticos</p>
            <p>Notificaciones inteligentes</p>
            <p>Recordatorios programados</p>
            <p>Actualizaciones en tiempo real</p>
          </div>
        </div>
        <div>
          <h4 class="font-semibold text-white mb-3">Análisis & Reportes</h4>
          <div class="text-neutral-300 space-y-1">
            <p>Dashboard interactivo</p>
            <p>Gráficos y métricas</p>
            <p>Reportes automáticos</p>
            <p>Exportación de datos</p>
          </div>
        </div>
      </div>
    </div>
  </BaseSection>

  <!-- Features Section -->
  <BaseSection>
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold mb-6 text-neutral-100">
        Módulos del Sistema
      </h2>
      <div class="w-24 h-1 bg-neutral-800 from-neutral-800 to-neutral-800 mx-auto mb-8"></div>
    </div>

    <div class="grid md:grid-cols-2 gap-8 max-w-6xl mx-auto">
      {features.map((feature, index) => (
        <div class={`group relative bg-neutral-800 from-neutral-800 to-neutral-900 rounded-2xl p-8 border border-neutral-700 hover:scale-105 transition-all duration-300 overflow-hidden`}>
          <div class={`absolute inset-0 bg-neutral-800 ${feature.gradient} opacity-0 group-hover:opacity-10 transition-opacity duration-300`}></div>
          <div class="relative z-10">
            <div class="text-4xl mb-4 group-hover:scale-110 transition-transform">
              <Icon name={feature.icon} size={38} class="project-icon" />
            </div>
            <h3 class="text-xl font-bold mb-4 text-white">
              {feature.title}
            </h3>
            <p class="text-neutral-300 leading-relaxed">
              {feature.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </BaseSection>

  <BaseSection>
    <div class="mx-auto max-w-4xl">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-4">Alcance del sistema</h2>
        <p class="text-neutral-300">Funciones para organizar la operación del programa deportivo universitario.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {[
          ["Asistencia", "Registro y consulta del pase de lista."],
          ["Eventos", "Organización de actividades y sesiones deportivas."],
          ["Calificaciones", "Captura y consulta de evaluaciones."],
          ["Reportes", "Vistas de información para apoyar el seguimiento."],
        ].map(([title, description]) => (
          <article class="rounded-2xl border border-white/10 bg-white/[0.03] p-6">
            <h3 class="mb-2 text-lg font-semibold text-white">{title}</h3>
            <p class="text-sm leading-relaxed text-neutral-300">{description}</p>
          </article>
        ))}
      </div>
    </div>
  </BaseSection>

  <!-- Development Process -->
  <BaseSection>
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold mb-6 text-neutral-100">
        Proceso de Implementación
      </h2>
      <div class="w-24 h-1 bg-neutral-800 from-neutral-800 to-neutral-800 mx-auto mb-8"></div>
    </div>

    <div class="max-w-4xl mx-auto">
      <div class="relative">
        <!-- Timeline line -->
        <div class="absolute left-1/2 transform -translate-x-px h-full w-0.5 bg-neutral-800 from-neutral-800 to-neutral-800 hidden md:block"></div>
        
        <div class="space-y-8">
          <!-- Step 1 -->
          <div class="flex items-center md:justify-between">
            <div class="md:w-5/12 bg-neutral-800 rounded-xl p-6 border border-neutral-700 hover:border-white/15 transition-colors">
              <h3 class="font-bold text-lg mb-2 text-neutral-200">1. Análisis de Necesidades</h3>
              <p class="text-neutral-300">Identificación de procesos manuales existentes y requerimientos específicos del programa de tenis universitario.</p>
            </div>
            <div class="hidden md:block w-2/12 text-center">
              <div class="w-8 h-8 bg-neutral-700 rounded-full mx-auto flex items-center justify-center text-white font-bold">1</div>
            </div>
            <div class="hidden md:block md:w-5/12"></div>
          </div>

          <!-- Step 2 -->
          <div class="flex items-center md:justify-between">
            <div class="hidden md:block md:w-5/12"></div>
            <div class="hidden md:block w-2/12 text-center">
              <div class="w-8 h-8 bg-neutral-700 rounded-full mx-auto flex items-center justify-center text-white font-bold">2</div>
            </div>
            <div class="md:w-5/12 bg-neutral-800 rounded-xl p-6 border border-neutral-700 hover:border-white/15 transition-colors">
              <h3 class="font-bold text-lg mb-2 text-neutral-200">2. Diseño de Arquitectura</h3>
              <p class="text-neutral-300">Estructuración de bases de datos, definición de flujos de trabajo y diseño de interfaces de usuario en Notion.</p>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="flex items-center md:justify-between">
            <div class="md:w-5/12 bg-neutral-800 rounded-xl p-6 border border-neutral-700 hover:border-white/15 transition-colors">
              <h3 class="font-bold text-lg mb-2 text-neutral-200">3. Desarrollo e Integración</h3>
              <p class="text-neutral-300">Implementación de módulos, configuración de automatizaciones y creación de dashboards para análisis de datos.</p>
            </div>
            <div class="hidden md:block w-2/12 text-center">
              <div class="w-8 h-8 bg-neutral-700 rounded-full mx-auto flex items-center justify-center text-white font-bold">3</div>
            </div>
            <div class="hidden md:block md:w-5/12"></div>
          </div>

          <!-- Step 4 -->
          <div class="flex items-center md:justify-between">
            <div class="hidden md:block md:w-5/12"></div>
            <div class="hidden md:block w-2/12 text-center">
              <div class="w-8 h-8 bg-neutral-700 rounded-full mx-auto flex items-center justify-center text-white font-bold">4</div>
            </div>
            <div class="md:w-5/12 bg-neutral-800 rounded-xl p-6 border border-neutral-700 hover:border-white/15 transition-colors">
              <h3 class="font-bold text-lg mb-2 text-neutral-200">4. Capacitación y Puesta en Marcha</h3>
              <p class="text-neutral-300">Entrenamiento del personal, pruebas piloto y ajustes finales basados en retroalimentación de usuarios.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </BaseSection>

  <!-- Gallery Section -->
  <BaseSection>
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold mb-6 text-neutral-100">
        Capturas del Sistema
      </h2>
      <div class="w-24 h-1 bg-neutral-800 from-neutral-800 to-neutral-800 mx-auto mb-8"></div>
    </div>
    
    <GalleryComponent images={screenshots} label="Capturas de Notion Tennis UPP" />
  </BaseSection>

  <!-- CTA Section -->
  <BaseSection className="text-center">
    <div class="bg-neutral-800 from-neutral-800 to-neutral-900 rounded-2xl p-12 border border-neutral-700">
      <h2 class="text-3xl font-bold mb-6 text-neutral-100">
        Proyecto de Servicio Social
      </h2>
      <p class="text-neutral-300 mb-8 max-w-2xl mx-auto">
        Este proyecto fue desarrollado como parte del servicio social en la Universidad Politécnica de Pachuca,
        demostrando el potencial de las soluciones no-code para resolver problemas reales en entornos educativos.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <div class="group relative inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-white rounded-xl bg-neutral-800 from-neutral-800 to-neutral-800 shadow-lg shadow-slate-500/25">
          <svg
            class="w-6 h-6 mr-3 text-white"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
          </svg>
          Sistema Implementado Exitosamente
        </div>
        
        <div class="flex items-center text-neutral-400">
          <span class="text-sm"><Icon name="trophy" size={22} /> Servicio Social UPP</span>
        </div>
      </div>
    </div>
  </BaseSection>
</Layout>
