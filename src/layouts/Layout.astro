---
import "../styles/global.css";

const home = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
const {
  title = "César Enríquez | Desarrollador de Software",
  description = "Portafolio de César Enríquez, desarrollador de software en Pachuca, Hidalgo. Proyectos de producto, sistemas empresariales y aplicaciones móviles.",
} = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#08090b" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${home}favicon.svg?v=2`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />
  </head>
  <body class={Astro.url.pathname.includes("/projects/") ? "project-page" : undefined}>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <header class="site-header">
      <a class="site-mark" href={home} aria-label="César Enríquez, inicio">
        <span class="site-mark__monogram" aria-hidden="true">CE</span>
        <span class="site-mark__name">César Enríquez</span>
      </a>
      <nav class="site-nav" aria-label="Navegación principal">
        <a href={`${home}#experiencia`}>Experiencia</a>
        <a href={`${home}#projects`}>Proyectos</a>
        <a class="site-nav__contact" href={`${home}#contact`}>Contacto</a>
      </nav>
    </header>

    <main id="main-content"><slot /></main>

    <footer class="site-footer">
      <a href={home} class="site-footer__name">César Enríquez</a>
      <p>Desarrollador de software · Pachuca, Hidalgo</p>
      <span>© {year}</span>
    </footer>

  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(:root) { --site-header-height: 5.5rem; }
  :global(html) { scroll-behavior: smooth; scroll-padding-top: 6rem; background: var(--bg); }
  :global(body) {
    margin: 0;
    min-width: 320px;
    overflow-x: hidden;
    background: var(--bg);
    color: var(--text);
    font-family: Inter, sans-serif;
    font-size: 16px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }
  :global(img) { max-width: 100%; }
  :global(a) { color: inherit; }
  :global(a:focus-visible), :global(button:focus-visible) {
    outline: 2px solid var(--accent-strong);
    outline-offset: 4px;
  }
  :global(::selection) { background: var(--accent); color: #08090b; }

  .skip-link {
    position: fixed; z-index: 10000; top: .75rem; left: .75rem;
    padding: .75rem 1rem; transform: translateY(-160%);
    background: var(--text); color: var(--bg); text-decoration: none;
  }
  .skip-link:focus { transform: translateY(0); }

  .site-header {
    position: absolute; z-index: 100; inset: 0 0 auto;
    display: flex; align-items: center; justify-content: space-between;
    width: min(100%, 100rem); height: 5.5rem; margin: auto;
    padding-inline: var(--page-gutter);
  }
  .site-mark { display: inline-flex; align-items: center; gap: .7rem; text-decoration: none; }
  .site-mark__monogram {
    display: grid; width: 2.25rem; aspect-ratio: 1; place-items: center;
    border: 1px solid var(--line); border-radius: 50%;
    font: 700 .72rem Syne, sans-serif; letter-spacing: -.06em;
  }
  .site-mark__name { font: 600 .9rem Syne, sans-serif; letter-spacing: -.02em; }
  .site-nav { display: flex; align-items: center; gap: clamp(1rem, 3vw, 2.5rem); }
  .site-nav a { color: var(--muted); font-size: .82rem; text-decoration: none; transition: color .18s ease; }
  .site-nav a:hover { color: var(--text); }
  .site-nav .site-nav__contact { color: var(--text); }

  :global(body.project-page .site-header) {
    position: sticky;
    top: 0;
    inset-inline: auto;
    width: 100%;
    height: var(--site-header-height);
    margin: 0;
    border-bottom: 1px solid rgba(231, 235, 240, .13);
    background: rgba(8, 9, 11, .9);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }
  :global(body.project-page #main-content > .project-hero + .section-base) {
    padding-block-start: clamp(1.25rem, 3svh, 2.5rem);
  }

  .site-footer {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    min-height: 6rem; padding: 1.25rem var(--page-gutter);
    border-top: 1px solid var(--line); color: var(--quiet); font-size: .78rem;
  }
  .site-footer p { margin: 0; }
  .site-footer__name { color: var(--text); font: 600 .9rem Syne, sans-serif; text-decoration: none; }

  :global(h1), :global(h2), :global(h3), :global(h4) {
    font-family: Syne, sans-serif; text-wrap: balance;
  }

  @media (max-width: 640px) {
    :global(:root) { --site-header-height: 4.5rem; }
    .site-header { height: 4.5rem; }
    .site-mark__name { display: none; }
    .site-nav { gap: .95rem; }
    .site-nav a { font-size: .75rem; }
    .site-footer { align-items: flex-start; flex-wrap: wrap; }
    .site-footer p { order: 3; flex-basis: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    :global(*), :global(*::before), :global(*::after) {
      animation-duration: .01ms !important; animation-iteration-count: 1 !important;
      scroll-behavior: auto !important; transition-duration: .01ms !important;
    }
  }
</style>
