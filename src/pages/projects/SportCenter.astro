---
import Layout from "../../layouts/Layout.astro";
import GalleryComponent from "../../components/organisms/GalleryComponent.astro";
import HeroTitle from "../../components/atoms/HeroTitle.astro";
import BaseSection from "../../components/atoms/BaseSection.astro";

const screenshots = [
  { src: "/Portfolio/images/projects/sportCenter/menu1.webp", alt: "Inicio de SportCenter" },
  { src: "/Portfolio/images/projects/sportCenter/menu2.webp", alt: "Navegación de la plataforma" },
  { src: "/Portfolio/images/projects/sportCenter/menu3.webp", alt: "Exploración de espacios deportivos" },
  { src: "/Portfolio/images/projects/sportCenter/login.webp", alt: "Acceso de usuario" },
  { src: "/Portfolio/images/projects/sportCenter/userDashboard.webp", alt: "Panel del usuario" },
  { src: "/Portfolio/images/projects/sportCenter/reservar1.webp", alt: "Selección de cancha" },
  { src: "/Portfolio/images/projects/sportCenter/reservar2.webp", alt: "Selección de horario" },
  { src: "/Portfolio/images/projects/sportCenter/reservar3.webp", alt: "Confirmación de reserva" },
  { src: "/Portfolio/images/projects/sportCenter/dashboardAdmin.webp", alt: "Panel administrativo" },
  { src: "/Portfolio/images/projects/sportCenter/adminCanchas.webp", alt: "Administración de canchas" },
  { src: "/Portfolio/images/projects/sportCenter/adminReservas.webp", alt: "Administración de reservas" },
  { src: "/Portfolio/images/projects/sportCenter/adminUsuarios.webp", alt: "Administración de usuarios" }
];

const techStack = [
  {
    name: "Next.js 14",
    icon: "code",
    description: "Framework React con App Router",
    gradient: "from-neutral-800 to-neutral-800"
  },
  {
    name: "Supabase",
    icon: "database",
    description: "Backend como servicio + PostgreSQL",
    gradient: "from-neutral-800 to-neutral-800"
  },
  {
    name: "TypeScript",
    icon: "code",
    description: "Tipado estático para desarrollo",
    gradient: "from-neutral-800 to-neutral-800"
  },
  {
    name: "Tailwind CSS",
    icon: "palette",
    description: "Framework CSS utility-first",
    gradient: "from-neutral-800 to-neutral-800"
  }
];

const features = [
  {
    title: "Sistema de Reservas Inteligente",
    description: "Plataforma completa para reservar canchas deportivas en tiempo real con validación automática de disponibilidad",
    icon: "calendar",
    gradient: "from-neutral-800 to-neutral-800",
    details: [
      "Calendario interactivo",
      "Validación en tiempo real",
      "Reserva con 24h anticipación",
      "Confirmación automática"
    ]
  },
  {
    title: "Gestión Premium de Instalaciones",
    description: "Administración completa de canchas de tenis, pádel y fútbol 5 con precios diferenciados y características específicas",
    icon: "trophy",
    gradient: "from-neutral-800 to-neutral-800",
    details: [
      "3 tipos de deportes",
      "Precios por deporte",
      "Gestión de disponibilidad",
      "Instalaciones premium"
    ]
  },
  {
    title: "Autenticación y Roles",
    description: "Sistema seguro con Supabase Auth que maneja usuarios, administradores y perfiles personalizados",
    icon: "lock",
    gradient: "from-neutral-800 to-neutral-800",
    details: [
      "Login/Registro seguro",
      "Roles USER/ADMIN",
      "Perfiles de usuario",
      "Middleware de protección"
    ]
  },
  {
    title: "Dashboard Administrativo",
    description: "Panel completo para administradores con gestión de canchas, usuarios, reservas y estadísticas del club",
    icon: "chart",
    gradient: "from-neutral-800 to-neutral-800",
    details: [
      "Gestión de canchas",
      "Control de reservas",
      "Estadísticas en tiempo real",
      "Panel de administración"
    ]
  }
];

const databaseSchema = [
  {
    table: "sport_types",
    description: "Tipos de deportes disponibles",
    fields: ["id", "name", "description", "max_people"]
  },
  {
    table: "courts",
    description: "Canchas deportivas del club",
    fields: ["id", "name", "sport_type_id", "price_per_hour", "active"]
  },
  {
    table: "user_profiles",
    description: "Perfiles de usuarios",
    fields: ["user_id", "name", "phone", "role"]
  },
  {
    table: "reservations",
    description: "Sistema de reservas",
    fields: ["user_id", "court_id", "date", "start_time", "status"]
  }
];

import Icon from "../../components/atoms/Icon.astro";
---

<Layout title="SportCenter | Reservas deportivas" description="Aplicación web para consultar y gestionar reservas de canchas deportivas y operaciones de un club.">
  <HeroTitle text="SPORTCENTER" />

  <!-- Hero Section -->
  <BaseSection className="text-center py-20 !max-w-5xl">
    <div class="max-w-4xl mx-auto">
      <!-- Status Badge -->
      <div class="inline-flex items-center space-x-2 px-4 py-2 bg-neutral-800 from-neutral-800 to-neutral-800 border border-white/15 rounded-full mb-8 hover:from-neutral-800 hover:to-neutral-800 hover:border-white/15 transition-all duration-300">
        <div class="w-2 h-2 bg-neutral-700 rounded-full animate-pulse"></div>
        <span class="text-neutral-200 font-semibold text-sm"><Icon name="trophy" size={22} /> Club Deportivo Premium</span>
      </div>

      <p class="text-xl text-neutral-300 max-w-3xl mx-auto leading-relaxed mb-8">
        Plataforma completa de gestión para club deportivo premium con sistema de reservas online,
        autenticación segura y dashboard administrativo desarrollado con Next.js y Supabase.
      </p>

      <!-- Tech Stack Pills -->
      <div class="flex flex-wrap justify-center gap-3 mb-10">
        <span class="px-4 py-2 bg-neutral-800 from-neutral-800 to-neutral-800 rounded-full text-sm font-semibold text-white hover:from-neutral-800 hover:to-neutral-800 hover:scale-105 transition-all duration-300 shadow-lg hover:shadow-black/20">
          Next.js 14
        </span>
        <span class="px-4 py-2 bg-neutral-800 from-neutral-800 to-neutral-800 rounded-full text-sm font-semibold text-white hover:from-neutral-800 hover:to-neutral-800 hover:scale-105 transition-all duration-300 shadow-lg hover:shadow-black/20">
          Supabase
        </span>
        <span class="px-4 py-2 bg-neutral-800 from-neutral-800 to-neutral-800 rounded-full text-sm font-semibold text-white hover:from-neutral-800 hover:to-neutral-800 hover:scale-105 transition-all duration-300 shadow-lg hover:shadow-black/20">
          TypeScript
        </span>
        <span class="px-4 py-2 bg-neutral-800 from-neutral-800 to-neutral-800 rounded-full text-sm font-semibold text-white hover:from-neutral-800 hover:to-neutral-800 hover:scale-105 transition-all duration-300 shadow-lg hover:shadow-black/20">
          Tailwind CSS
        </span>
      </div>

      <!-- Demo Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-8">
        <a
          href="https://sport-center-eight.vercel.app"
          class="group relative inline-flex items-center justify-center px-10 py-5 text-lg font-bold text-white rounded-2xl bg-neutral-800 from-neutral-800 via-teal-500 to-neutral-800 hover:from-neutral-800 hover:via-teal-400 hover:to-neutral-800 transition-all duration-300 shadow-2xl hover:shadow-black/20 hover:scale-110 hover:-translate-y-1 transform border border-white/15 hover:border-white/15"
        >
          <div class="absolute inset-0 bg-neutral-800 from-white/20 to-transparent rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          <svg
            class="w-7 h-7 mr-3 text-white group-hover:scale-125 group-hover:rotate-12 transition-all duration-300"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
          <span class="relative z-10">Demo en Vivo</span>
          <div class="absolute inset-0 rounded-2xl bg-neutral-800 from-neutral-800 to-neutral-800 opacity-0 group-hover:opacity-20 blur-xl transition-opacity duration-300"></div>
        </a>
      </div>
    </div>
  </BaseSection>

  <!-- Problem Solution Section -->
  <BaseSection className="!max-w-5xl">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold mb-6 text-neutral-100">
          Modernizando la Gestión Deportiva
        </h2>
        <div class="w-24 h-1 bg-neutral-800 from-neutral-800 to-neutral-800 mx-auto mb-8"></div>
      </div>

      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="space-y-6">
          <div class="bg-white/5 border border-white/15 rounded-xl p-6 hover:bg-white/5 hover:border-white/15 hover:scale-105 transition-all duration-300 group">
            <h3 class="text-xl font-bold text-neutral-200 mb-4 group-hover:text-neutral-300 transition-colors"><Icon name="x" size={22} /> Desafíos Identificados</h3>
            <ul class="text-neutral-300 space-y-3 text-sm group-hover:text-neutral-200 transition-colors">
              <li class="flex items-start space-x-2">
                <span class="text-neutral-200 mt-1">•</span>
                <span>Gestión manual de reservas propensa a errores</span>
              </li>
              <li class="flex items-start space-x-2">
                <span class="text-neutral-200 mt-1">•</span>
                <span>Falta de sistema digital para clubs deportivos</span>
              </li>
              <li class="flex items-start space-x-2">
                <span class="text-neutral-200 mt-1">•</span>
                <span>Ausencia de control de disponibilidad en tiempo real</span>
              </li>
              <li class="flex items-start space-x-2">
                <span class="text-neutral-200 mt-1">•</span>
                <span>Necesidad de interfaz moderna y responsive</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="space-y-6">
          <div class="bg-white/5 border border-white/15 rounded-xl p-6 hover:bg-white/5 hover:border-white/15 hover:scale-105 transition-all duration-300 group">
            <h3 class="text-xl font-bold text-neutral-200 mb-4 group-hover:text-neutral-300 transition-colors"><Icon name="check" size={22} /> Solución SportCenter</h3>
            <ul class="text-neutral-300 space-y-3 text-sm group-hover:text-neutral-200 transition-colors">
              <li class="flex items-start space-x-2">
                <span class="text-neutral-200 mt-1">•</span>
                <span>Sistema automatizado de reservas online</span>
              </li>
              <li class="flex items-start space-x-2">
                <span class="text-neutral-200 mt-1">•</span>
                <span>Plataforma escalable con tecnologías modernas</span>
              </li>
              <li class="flex items-start space-x-2">
                <span class="text-neutral-200 mt-1">•</span>
                <span>Validación en tiempo real de disponibilidad</span>
              </li>
              <li class="flex items-start space-x-2">
                <span class="text-neutral-200 mt-1">•</span>
                <span>Experiencia de usuario premium y responsiva</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </BaseSection>

  <!-- Tech Stack & Architecture -->
  <BaseSection className="!max-w-5xl">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold mb-6 text-neutral-100">
        Stack Tecnológico Moderno
      </h2>
      <div class="w-24 h-1 bg-neutral-800 from-neutral-800 to-neutral-800 mx-auto mb-8"></div>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto mb-16">
      {techStack.map((tech) => (
        <div class="group bg-neutral-800 from-neutral-800 to-neutral-900 rounded-2xl p-6 border border-neutral-700 hover:border-white/15 hover:scale-110 hover:-translate-y-2 transition-all duration-500 hover:shadow-2xl hover:shadow-black/20">
          <div class="text-4xl mb-4 text-center group-hover:scale-125 group-hover:rotate-6 transition-all duration-500">
            <Icon name={tech.icon} size={38} class="project-icon" />
          </div>
          <h3 class="text-lg font-bold text-center mb-2 text-white group-hover:text-neutral-200 transition-colors duration-300">
            {tech.name}
          </h3>
          <p class="text-neutral-400 text-sm text-center group-hover:text-neutral-300 transition-colors duration-300">
            {tech.description}
          </p>
          <div class={`mt-4 h-1 rounded bg-neutral-800 ${tech.gradient} mx-auto w-0 group-hover:w-full transition-all duration-500`}></div>
        </div>
      ))}
    </div>

    <!-- Database Schema -->
    <div class="bg-neutral-800 from-neutral-800/50 to-neutral-900/50 rounded-2xl p-8 border border-neutral-700 hover:border-white/15 hover:shadow-xl hover:shadow-black/20 transition-all duration-300">
      <h3 class="text-2xl font-bold text-center mb-8 text-neutral-200">Arquitectura de Base de Datos</h3>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {databaseSchema.map((table) => (
          <div class="text-center bg-neutral-700/50 rounded-xl p-6 hover:bg-neutral-700/70 hover:scale-105 transition-all duration-300 group">
            <h4 class="font-semibold text-white mb-3 group-hover:text-neutral-200 transition-colors">{table.table}</h4>
            <p class="text-neutral-400 text-sm mb-4 group-hover:text-neutral-300 transition-colors">
              {table.description}
            </p>
            <div class="space-y-1">
              {table.fields.map((field) => (
                <div class="text-xs text-neutral-500 font-mono bg-neutral-800/50 px-2 py-1 rounded">
                  {field}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </BaseSection>

  <!-- Features Section -->
  <BaseSection className="!max-w-5xl">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold mb-6 text-neutral-100">
        Funcionalidades Principales
      </h2>
      <div class="w-24 h-1 bg-neutral-800 from-neutral-800 to-neutral-800 mx-auto mb-8"></div>
    </div>

    <div class="grid lg:grid-cols-2 gap-8 max-w-6xl mx-auto">
      {features.map((feature, index) => (
        <div class="group relative bg-neutral-800 from-neutral-800 to-neutral-900 rounded-2xl p-8 border border-neutral-700 hover:border-white/15 hover:scale-105 hover:-translate-y-2 transition-all duration-500 overflow-hidden hover:shadow-2xl hover:shadow-black/20">
          <div class={`absolute inset-0 bg-neutral-800 ${feature.gradient} opacity-0 group-hover:opacity-15 transition-opacity duration-500`}></div>

          <div class="relative z-10">
            <div class="flex items-start space-x-4 mb-6">
              <div class="text-4xl group-hover:scale-125 group-hover:rotate-12 transition-all duration-500">
                <Icon name={feature.icon} size={38} class="project-icon" />
              </div>
              <div class="flex-1">
                <h3 class="text-xl font-bold mb-3 text-white group-hover:text-neutral-200 transition-colors duration-300">
                  {feature.title}
                </h3>
                <p class="text-neutral-300 leading-relaxed mb-4 group-hover:text-neutral-200 transition-colors duration-300">
                  {feature.description}
                </p>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-2">
              {feature.details.map((detail) => (
                <div class="flex items-center space-x-2 text-sm text-neutral-400 group-hover:text-neutral-300 transition-colors duration-300">
                  <div class="w-1.5 h-1.5 bg-neutral-700 rounded-full group-hover:bg-neutral-700 transition-colors"></div>
                  <span>{detail}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </BaseSection>

  <BaseSection id="alcance">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold mb-8 text-neutral-100">Alcance del proyecto</h2>
      <div class="grid md:grid-cols-3 gap-5">
        <article class="bg-neutral-800 rounded-xl p-6 border border-white/10">
          <h3 class="text-lg font-semibold text-neutral-100 mb-2">Reservas de canchas</h3>
          <p class="text-neutral-300 text-sm">Consulta de disponibilidad y creación de reservas para las instalaciones deportivas.</p>
        </article>
        <article class="bg-neutral-800 rounded-xl p-6 border border-white/10">
          <h3 class="text-lg font-semibold text-neutral-100 mb-2">Cuentas y permisos</h3>
          <p class="text-neutral-300 text-sm">Acceso para usuarios y administradores con funciones distintas dentro del sistema.</p>
        </article>
        <article class="bg-neutral-800 rounded-xl p-6 border border-white/10">
          <h3 class="text-lg font-semibold text-neutral-100 mb-2">Gestión del club</h3>
          <p class="text-neutral-300 text-sm">Vistas administrativas para revisar reservas, usuarios y canchas.</p>
        </article>
      </div>
    </div>
  </BaseSection>

  <!-- Technical Implementation -->
  <BaseSection className="!max-w-5xl">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold mb-6 text-neutral-100">
        Implementación Técnica
      </h2>
      <div class="w-24 h-1 bg-neutral-800 from-neutral-800 to-neutral-800 mx-auto mb-8"></div>
    </div>

    <div class="max-w-5xl mx-auto">
      <div class="grid md:grid-cols-2 gap-8 mb-12">
        <!-- Frontend Architecture -->
        <div class="bg-neutral-800 from-neutral-800 to-neutral-900 rounded-2xl p-8 border border-neutral-700 hover:border-white/15 hover:scale-105 transition-all duration-300 group hover:shadow-xl hover:shadow-black/20">
          <div class="text-center mb-6">
            <div class="text-4xl mb-3 group-hover:scale-110 group-hover:rotate-6 transition-all duration-300"><Icon name="code" size={22} /></div>
            <h3 class="text-xl font-bold text-white mb-2 group-hover:text-neutral-200 transition-colors">Frontend Moderno</h3>
            <p class="text-neutral-400 text-sm group-hover:text-neutral-300 transition-colors">Next.js 14 con App Router</p>
          </div>

          <div class="space-y-4">
            <div class="bg-neutral-700/50 rounded-lg p-4 hover:bg-neutral-700/70 transition-colors duration-300 group/item">
              <h4 class="font-semibold text-neutral-200 mb-2 group-hover/item:text-neutral-300 transition-colors"><Icon name="rocket" size={22} /> Server Components</h4>
              <p class="text-neutral-300 text-sm group-hover/item:text-neutral-200 transition-colors">React Server Components para mejor SEO y performance</p>
            </div>

            <div class="bg-neutral-700/50 rounded-lg p-4 hover:bg-neutral-700/70 transition-colors duration-300 group/item">
              <h4 class="font-semibold text-neutral-200 mb-2 group-hover/item:text-neutral-300 transition-colors"><Icon name="code" size={22} /> TypeScript</h4>
              <p class="text-neutral-300 text-sm group-hover/item:text-neutral-200 transition-colors">Tipado estático completo para desarrollo seguro</p>
            </div>
          </div>
        </div>

        <!-- Backend Architecture -->
        <div class="bg-neutral-800 from-neutral-800 to-neutral-900 rounded-2xl p-8 border border-neutral-700 hover:border-white/15 hover:scale-105 transition-all duration-300 group hover:shadow-xl hover:shadow-black/20">
          <div class="text-center mb-6">
            <div class="text-4xl mb-3 group-hover:scale-110 group-hover:rotate-6 transition-all duration-300"><Icon name="database" size={22} /></div>
            <h3 class="text-xl font-bold text-white mb-2 group-hover:text-neutral-200 transition-colors">Backend Escalable</h3>
            <p class="text-neutral-400 text-sm group-hover:text-neutral-300 transition-colors">Supabase como Backend-as-a-Service</p>
          </div>

          <div class="space-y-4">
            <div class="bg-neutral-700/50 rounded-lg p-4 hover:bg-neutral-700/70 transition-colors duration-300 group/item">
              <h4 class="font-semibold text-neutral-200 mb-2 group-hover/item:text-neutral-300 transition-colors"><Icon name="database" size={22} /> PostgreSQL</h4>
              <p class="text-neutral-300 text-sm group-hover/item:text-neutral-200 transition-colors">Base de datos robusta con Row Level Security</p>
            </div>

            <div class="bg-neutral-700/50 rounded-lg p-4 hover:bg-neutral-700/70 transition-colors duration-300 group/item">
              <h4 class="font-semibold text-neutral-200 mb-2 group-hover/item:text-neutral-300 transition-colors"><Icon name="lock" size={22} /> Auth Integrado</h4>
              <p class="text-neutral-300 text-sm group-hover/item:text-neutral-200 transition-colors">Autenticación JWT con manejo automático de sesiones</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Code Implementation Example -->
      <div class="bg-neutral-800 from-neutral-800/50 to-neutral-900/50 rounded-2xl p-8 border border-neutral-700 hover:border-white/15 hover:shadow-xl hover:shadow-black/20 transition-all duration-300 group">
        <h3 class="text-2xl font-bold text-center mb-8 text-neutral-200 group-hover:text-neutral-300 transition-colors">Ejemplo de Implementación</h3>

        <div class="bg-neutral-900 rounded-xl p-6 border border-neutral-700 hover:border-white/15 transition-colors duration-300">
          <div class="flex items-center justify-between mb-4">
            <span class="text-sm text-neutral-400">TypeScript + Supabase</span>
            <span class="text-xs text-neutral-500">Sistema de reservas</span>
          </div>
          <pre class="text-sm text-neutral-300 overflow-x-auto"><code>{`// Validación de reserva con Supabase
const handleReservation = async () => {
  const { data: existingReservations, error } = await supabase
    .from('reservations')
    .select('*')
    .eq('court_id', selectedCourt.id)
    .eq('date', selectedDate.toISOString().split('T')[0])
    .eq('status', 'ACTIVE')

  // Validar conflictos de horario
  const hasConflict = existingReservations?.some(reservation =>
    timeOverlap(reservation.start_time, reservation.end_time,
                selectedTime, endTime))

  if (!hasConflict) {
    const { error } = await supabase
      .from('reservations')
      .insert({
        user_id: user.id,
        court_id: selectedCourt.id,
        date: selectedDate,
        start_time: selectedTime,
        status: 'ACTIVE'
      })
  }
}`}</code></pre>
        </div>

        <div class="mt-6 text-center">
          <div class="inline-flex items-center space-x-2 px-4 py-2 bg-white/10 border border-white/15 rounded-lg hover:bg-white/10 hover:border-white/15 transition-all duration-300">
            <span class="text-xl"><Icon name="sparkles" size={22} /></span>
            <span class="text-neutral-200 text-sm">Validación en tiempo real</span>
          </div>
        </div>
      </div>
    </div>
  </BaseSection>

  <!-- Development Process -->
  <BaseSection className="!max-w-5xl">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold mb-6 text-neutral-100">
        Proceso de Desarrollo
      </h2>
      <div class="w-24 h-1 bg-neutral-800 from-neutral-800 to-neutral-800 mx-auto mb-8"></div>
    </div>

    <div class="max-w-4xl mx-auto">
      <div class="relative">
        <!-- Timeline line -->
        <div class="absolute left-1/2 transform -translate-x-px h-full w-0.5 bg-neutral-800 from-neutral-800 to-neutral-800 hidden md:block"></div>

        <div class="space-y-8">
          <!-- Step 1 -->
          <div class="flex items-center md:justify-between">
            <div class="md:w-5/12 bg-neutral-800 rounded-xl p-6 border border-neutral-700 hover:border-white/15 transition-colors">
              <div class="flex items-center space-x-3 mb-3">
                <span class="text-2xl"><Icon name="clipboard" size={22} /></span>
                <h3 class="font-bold text-lg text-neutral-200">Análisis y Diseño</h3>
              </div>
              <p class="text-neutral-300 text-sm">Modelado de entidades deportivas, diseño de UX/UI y definición de la arquitectura del sistema con Next.js y Supabase.</p>
            </div>
            <div class="hidden md:block w-2/12 text-center">
