---
interface Technology { label: string; icon: string; category: string }
const { techs } = Astro.props as { techs: Technology[] };
const highlighted = [
  { label: "React + Vite", icon: "devicon-react-original colored", secondaryIcon: "devicon-vitejs-plain colored" },
  { label: "Flutter", icon: "devicon-flutter-plain colored" },
  { label: "Angular", icon: "devicon-angular-plain colored" },
  { label: "AWS", icon: "devicon-amazonwebservices-plain-wordmark colored" },
];
const groups = Object.entries(
  techs.reduce<Record<string, Technology[]>>((all, tech) => {
    (all[tech.category] ??= []).push(tech);
    return all;
  }, {}),
);
---

<section id="tecnologias" class="tech-section reveal-section">
  <div class="tech-inner">
    <div class="tech-heading">
      <div>
        <p>Herramientas</p>
        <h2>Tecnologías</h2>
      </div>
      <span>Un stack que cambia según el problema.</span>
    </div>
    <div class="tech-highlight" aria-label="Tecnologías de experiencia ampliada">
      <p>Experiencia ampliada</p>
      <ul>
        {highlighted.map((item) => (
          <li>
            <i class={item.icon} aria-hidden="true"></i>
            {item.secondaryIcon && <i class={item.secondaryIcon} aria-hidden="true"></i>}
            <span>{item.label}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="tech-groups">
      {groups.map(([category, items]) => (
        <section class="tech-group" aria-label={category}>
          <h3>{category}</h3>
          <ul>
            {items.map((tech) => (
              <li>
                <i class={`${tech.icon} colored tech-icon`} aria-hidden="true"></i>
                <span>{tech.label}</span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .tech-section { padding: clamp(4.5rem, 9vw, 8rem) var(--page-gutter); background: var(--surface); }
  .tech-inner { width: min(100%, var(--content-width)); margin: 0 auto; }
  .tech-heading { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin-bottom: 2.5rem; }
  .tech-heading p { margin: 0 0 .65rem; color: var(--muted); font-size: .78rem; }
  .tech-heading h2 { margin: 0; font-size: clamp(2.2rem, 5vw, 3.75rem); line-height: 1; letter-spacing: -.06em; }
  .tech-heading > span { max-width: 20rem; color: var(--muted); font-size: .9rem; }
  .tech-highlight { margin: 0 0 1.5rem; }
  .tech-highlight > p { margin: 0 0 .7rem; color: var(--quiet); font-size: .72rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .tech-highlight ul { display: flex; flex-wrap: wrap; gap: .6rem; margin: 0; padding: 0; list-style: none; }
  .tech-highlight li { display: flex; min-height: 2.65rem; align-items: center; gap: .5rem; padding: .55rem .8rem; border: 1px solid var(--line); border-radius: 999px; background: linear-gradient(125deg, rgba(76,232,192,.11), rgba(181,148,255,.1)); color: var(--text); font-size: .82rem; font-weight: 600; }
  .tech-highlight i { font-size: 1rem; }
  .tech-groups { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .tech-group { padding: 1.2rem; border: 1px solid var(--line); border-radius: var(--radius); }
  .tech-group h3 { margin: 0 0 1rem; color: var(--quiet); font: 600 .75rem Inter, sans-serif; letter-spacing: .04em; text-transform: capitalize; }
  .tech-group ul { display: flex; flex-wrap: wrap; gap: .7rem 1rem; margin: 0; padding: 0; list-style: none; }
  .tech-group li { display: inline-flex; align-items: center; gap: .45rem; color: var(--text); font-size: .8rem; }
  .tech-icon { font-size: 1rem; opacity: 1; }
  @media (max-width: 820px) { .tech-groups { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) {
    .tech-heading { align-items: flex-start; flex-direction: column; gap: 1rem; }
    .tech-groups { grid-template-columns: 1fr; }
    .tech-highlight li { min-height: 2.45rem; font-size: .76rem; }
  }
</style>
