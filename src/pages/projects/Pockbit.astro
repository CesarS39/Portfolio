---
import Layout from "../../layouts/Layout.astro";
import GalleryComponent from "../../components/organisms/GalleryComponent.astro";
import HeroTitle from "../../components/atoms/HeroTitle.astro";
import BaseSection from "../../components/atoms/BaseSection.astro";

const screenshots = [
  { src: "/Portfolio/images/projects/pockbit/pockbit.webp", alt: "Punto de venta Pockbit" },
  { src: "/Portfolio/images/projects/pockbit/login.webp", alt: "Acceso al sistema" },
  { src: "/Portfolio/images/projects/pockbit/dashboard.webp", alt: "Panel de control" },
  { src: "/Portfolio/images/projects/pockbit/compras.webp", alt: "Gestión de compras" },
  { src: "/Portfolio/images/projects/pockbit/laboratorios.webp", alt: "Catálogo de laboratorios" },
  { src: "/Portfolio/images/projects/pockbit/medicamentos.webp", alt: "Inventario de medicamentos" }
];

const techStack = [
  {
    name: ".NET Framework",
    icon: "code",
    description: "Backend robusto con C#"
  },
  {
    name: "SQL Server",
    icon: "database",
    description: "Base de datos empresarial"
  },
  {
    name: "Azure",
    icon: "cloud",
    description: "Cloud hosting y servicios"
  },
  {
    name: "Bootstrap",
    icon: "palette",
    description: "UI responsiva y moderna"
  }
];

const features = [
  {
    title: "Gestión Farmacéutica Especializada",
    description: "Control de caducidades por lote, precios máximos y trazabilidad completa de medicamentos",
    icon: "pill",
    gradient: "from-neutral-800 to-neutral-800"
  },
  {
    title: "Arquitectura Empresarial",
    description: "Transacciones ACID, normalización 3FN, CQRS para reportes y capas separadas",
    icon: "layers",
    gradient: "from-neutral-800 to-neutral-800"
  },
  {
    title: "Integridad de Datos",
    description: "Validaciones multicapa, rollback automático y consistencia garantizada",
    icon: "shield",
    gradient: "from-neutral-800 to-neutral-800"
  },
  {
    title: "Arquitectura del sistema",
    description: "Separación por capas, componentes desacoplados y persistencia relacional.",
    icon: "chart",
    gradient: "from-neutral-800 to-neutral-800"
  }
];
import Icon from "../../components/atoms/Icon.astro";
---

<Layout title="Pockbit | Punto de venta farmacéutico" description="Sistema de punto de venta orientado a distribuidoras farmacéuticas, con inventario y control de operaciones.">
  <HeroTitle text="POCKBIT" />
  <!-- Hero Section -->
  <BaseSection className="pockbit-intro">
    
    <div class="mt-8">
      <p class="pockbit-intro__copy">
        Sistema integral de punto de venta diseñado específicamente para distribuidoras farmacéuticas,
        transformando operaciones manuales en procesos automatizados y eficientes.
      </p>
      <div class="pockbit-intro__tech">
        <span class="px-4 py-2 bg-neutral-800 from-neutral-800 to-neutral-800 rounded-full text-sm font-semibold">
          .NET Framework
        </span>
        <span class="px-4 py-2 bg-neutral-800 from-neutral-800 to-neutral-800 rounded-full text-sm font-semibold">
          SQL Server
        </span>
        <span class="px-4 py-2 bg-neutral-800 from-neutral-800 to-neutral-800 rounded-full text-sm font-semibold">
          Azure Cloud
        </span>
        <span class="px-4 py-2 bg-neutral-800 from-neutral-800 to-neutral-800 rounded-full text-sm font-semibold">
          Bootstrap
        </span>
      </div>
    </div>
  </BaseSection>

  <!-- Problem Solution Section -->
  <BaseSection>
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold mb-6 text-neutral-100">
          Transformando el Negocio Farmacéutico
        </h2>
        <div class="w-24 h-1 bg-neutral-800 from-neutral-800 to-neutral-800 mx-auto mb-8"></div>
      </div>
      
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="space-y-6">
          <div class="bg-white/5 border border-white/15 rounded-xl p-6">
            <h3 class="text-xl font-bold text-neutral-200 mb-3"><Icon name="x" size={22} /> Situación Anterior</h3>
            <ul class="text-neutral-300 space-y-2">
              <li>• Operación manual con Excel</li>
              <li>• Errores frecuentes en inventario</li>
              <li>• Información desactualizada</li>
              <li>• Procesos lentos e ineficientes</li>
            </ul>
          </div>
        </div>
        
        <div class="space-y-6">
          <div class="bg-white/5 border border-white/15 rounded-xl p-6">
            <h3 class="text-xl font-bold text-neutral-200 mb-3"><Icon name="check" size={22} /> Solución Pockbit</h3>
            <ul class="text-neutral-300 space-y-2">
              <li>• Automatización completa</li>
              <li>• Operación simultánea multi-usuario</li>
              <li>• Reportes automáticos en tiempo real</li>
              <li>• Validaciones y controles de integridad</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </BaseSection>

  <!-- Tech Stack Destacado -->
  <BaseSection>
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold mb-6 text-neutral-100">
        Stack Tecnológico Empresarial
      </h2>
      <div class="w-24 h-1 bg-neutral-800 from-neutral-800 to-neutral-800 mx-auto mb-8"></div>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
      {techStack.map((tech) => (
        <div class="group bg-neutral-800 from-neutral-800 to-neutral-900 rounded-2xl p-6 border border-neutral-700 hover:border-white/15 hover:scale-105 transition-all duration-300">
          <div class="text-4xl mb-4 text-center group-hover:scale-110 transition-transform">
            <Icon name={tech.icon} size={38} class="project-icon" />
          </div>
          <h3 class="text-lg font-bold text-center mb-2 text-white">
            {tech.name}
          </h3>
          <p class="text-neutral-400 text-sm text-center">
            {tech.description}
          </p>
        </div>
      ))}
    </div>

    <!-- Detalles técnicos expandidos -->
    <div class="mt-12 bg-neutral-800 from-neutral-800/50 to-neutral-900/50 rounded-2xl p-8 border border-neutral-700">
      <h3 class="text-2xl font-bold text-center mb-8 text-neutral-200">Arquitectura & Herramientas</h3>
      <div class="grid md:grid-cols-3 gap-8 text-center">
        <div>
          <h4 class="font-semibold text-white mb-3">Backend</h4>
          <div class="text-neutral-300 space-y-1">
            <p>C# con .NET Framework</p>
            <p>Patrón MVC</p>
            <p>Lógica de negocio separada</p>
            <p>DAOs y DTOs</p>
          </div>
        </div>
        <div>
          <h4 class="font-semibold text-white mb-3">Base de Datos</h4>
          <div class="text-neutral-300 space-y-1">
            <p>SQL Server</p>
            <p>Azure SQL Database</p>
            <p>Procedimientos almacenados</p>
            <p>Vistas optimizadas</p>
          </div>
        </div>
        <div>
          <h4 class="font-semibold text-white mb-3">Frontend & Cloud</h4>
          <div class="text-neutral-300 space-y-1">
            <p>Bootstrap + JavaScript</p>
            <p>Diseño responsivo</p>
            <p>Azure App Service</p>
            <p>Despliegue automático</p>
          </div>
        </div>
      </div>
    </div>
  </BaseSection>

  <!-- Features Section -->
  <BaseSection>
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold mb-6 text-neutral-100">
        Características Clave
      </h2>
      <div class="w-24 h-1 bg-neutral-800 from-neutral-800 to-neutral-800 mx-auto mb-8"></div>
    </div>

    <div class="grid md:grid-cols-2 gap-8 max-w-6xl mx-auto">
      {features.map((feature, index) => (
        <div class={`group relative bg-neutral-800 from-neutral-800 to-neutral-900 rounded-2xl p-8 border border-neutral-700 hover:scale-105 transition-all duration-300 overflow-hidden`}>
          <div class={`absolute inset-0 bg-neutral-800 ${feature.gradient} opacity-0 group-hover:opacity-10 transition-opacity duration-300`}></div>
          <div class="relative z-10">
            <div class="text-4xl mb-4 group-hover:scale-110 transition-transform">
              <Icon name={feature.icon} size={38} class="project-icon" />
            </div>
            <h3 class="text-xl font-bold mb-4 text-white">
              {feature.title}
            </h3>
            <p class="text-neutral-300 leading-relaxed">
              {feature.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </BaseSection>

  <!-- Development Process -->
  <BaseSection>
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold mb-6 text-neutral-100">
        Proceso de Desarrollo
      </h2>
      <div class="w-24 h-1 bg-neutral-800 from-neutral-800 to-neutral-800 mx-auto mb-8"></div>
    </div>

    <div class="max-w-4xl mx-auto">
      <div class="relative">
        <!-- Timeline line -->
        <div class="absolute left-1/2 transform -translate-x-px h-full w-0.5 bg-neutral-800 from-neutral-800 to-neutral-800 hidden md:block"></div>
        
        <div class="space-y-8">
          <!-- Step 1 -->
          <div class="flex items-center md:justify-between">
            <div class="md:w-5/12 bg-neutral-800 rounded-xl p-6 border border-neutral-700 hover:border-white/15 transition-colors">
              <h3 class="font-bold text-lg mb-2 text-neutral-200">1. Análisis con Cliente</h3>
              <p class="text-neutral-300">Identificación de necesidades específicas del sector farmacéutico y mapeo de procesos existentes.</p>
            </div>
            <div class="hidden md:block w-2/12 text-center">
              <div class="w-8 h-8 bg-neutral-700 rounded-full mx-auto flex items-center justify-center text-white font-bold">1</div>
            </div>
            <div class="hidden md:block md:w-5/12"></div>
          </div>

          <!-- Step 2 -->
          <div class="flex items-center md:justify-between">
            <div class="hidden md:block md:w-5/12"></div>
            <div class="hidden md:block w-2/12 text-center">
              <div class="w-8 h-8 bg-neutral-700 rounded-full mx-auto flex items-center justify-center text-white font-bold">2</div>
            </div>
            <div class="md:w-5/12 bg-neutral-800 rounded-xl p-6 border border-neutral-700 hover:border-white/15 transition-colors">
              <h3 class="font-bold text-lg mb-2 text-neutral-200">2. Diseño de Arquitectura</h3>
              <p class="text-neutral-300">Modelado de datos, definición de capas y selección del stack tecnológico apropiado.</p>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="flex items-center md:justify-between">
            <div class="md:w-5/12 bg-neutral-800 rounded-xl p-6 border border-neutral-700 hover:border-white/15 transition-colors">
              <h3 class="font-bold text-lg mb-2 text-neutral-200">3. Desarrollo Iterativo</h3>
              <p class="text-neutral-300">Implementación con pruebas continuas y validación constante de funcionalidades.</p>
            </div>
            <div class="hidden md:block w-2/12 text-center">
              <div class="w-8 h-8 bg-neutral-700 rounded-full mx-auto flex items-center justify-center text-white font-bold">3</div>
            </div>
            <div class="hidden md:block md:w-5/12"></div>
          </div>

          <!-- Step 4 -->
          <div class="flex items-center md:justify-between">
            <div class="hidden md:block md:w-5/12"></div>
            <div class="hidden md:block w-2/12 text-center">
              <div class="w-8 h-8 bg-neutral-700 rounded-full mx-auto flex items-center justify-center text-white font-bold">4</div>
            </div>
            <div class="md:w-5/12 bg-neutral-800 rounded-xl p-6 border border-neutral-700 hover:border-white/15 transition-colors">
              <h3 class="font-bold text-lg mb-2 text-neutral-200">4. Validación y Despliegue</h3>
              <p class="text-neutral-300">Pruebas con usuarios reales, ajustes finales y despliegue en Azure Cloud.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </BaseSection>

  <!-- Gallery Section -->
  <BaseSection>
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold mb-6 text-neutral-100">
        Capturas del Sistema
      </h2>
      <div class="w-24 h-1 bg-neutral-800 from-neutral-800 to-neutral-800 mx-auto mb-8"></div>
    </div>
    
    <GalleryComponent images={screenshots} label="Capturas del punto de venta Pockbit" title="Pockbit" />
  </BaseSection>

</Layout>

<style>
  :global(.pockbit-intro.section-base) {
    text-align: left;
  }
  :global(.pockbit-intro .section-inner) { max-width: var(--content-width); }
  .pockbit-intro__copy {
    max-width: 46rem;
    margin: 0;
    color: var(--muted);
    font-size: clamp(1.1rem, 2.1vw, 1.4rem);
    line-height: 1.55;
  }
  .pockbit-intro__tech {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: .75rem;
    margin-top: 1.75rem;
  }
</style>
