---
const { id = "", className = "" } = Astro.props;
---

<section id={id} class={`section-base ${className}`}>
  <div class="section-inner"><slot /></div>
</section>

<style>
  .section-base { padding: clamp(3.75rem, 8vw, 7rem) var(--page-gutter); background: var(--bg); color: var(--text); }
  .section-inner { width: min(100%, 64rem); margin-inline: auto; }
</style>
