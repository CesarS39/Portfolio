---
import Layout from "../../layouts/Layout.astro";
import GalleryComponent from "../../components/organisms/GalleryComponent.astro";
import HeroTitle from "../../components/atoms/HeroTitle.astro";
import BaseSection from "../../components/atoms/BaseSection.astro";

const screenshots = [
  { src: "/Portfolio/images/projects/myspot/IMG_5053.webp", alt: "Explorar lugares en Pachuca", orientation: "portrait" as const },
  { src: "/Portfolio/images/projects/myspot/IMG_5055.webp", alt: "Detalle de un lugar", orientation: "portrait" as const },
  { src: "/Portfolio/images/projects/myspot/IMG_5057.webp", alt: "Información y reseñas del lugar", orientation: "portrait" as const },
  { src: "/Portfolio/images/projects/myspot/IMG_5059.webp", alt: "Acceso a la aplicación", orientation: "portrait" as const },
  { src: "/Portfolio/images/projects/myspot/IMG_5061.webp", alt: "Perfil y configuración de cuenta", orientation: "portrait" as const },
  { src: "/Portfolio/images/projects/myspot/IMG_5063.webp", alt: "Cambio de contraseña", orientation: "portrait" as const },
];

const techStack = [
  {
    name: "Flutter",
    icon: "phone",
    description: "UI nativa multiplataforma",
    gradient: "from-neutral-800 to-neutral-800",
  },
  {
    name: "Firebase",
    icon: "flame",
    description: "Auth y servicios en tiempo real",
    gradient: "from-neutral-800 to-neutral-800",
  },
  {
    name: "FastAPI",
    icon: "sparkles",
    description: "Microservicios con Python",
    gradient: "from-neutral-800 to-neutral-800",
  },
  {
    name: "MongoDB",
    icon: "leaf",
    description: "Base de datos NoSQL",
    gradient: "from-neutral-800 to-neutral-800",
  },
];

const features = [
  {
    title: "Descubrimiento Social de Lugares",
    description:
      "Explora lugares por categorías con calificaciones reales de usuarios y reseñas tipo red social",
    icon: "map",
    gradient: "from-neutral-800 to-neutral-800",
    details: [
      "Categorización inteligente",
      "Filtros avanzados",
      "Geolocalización",
      "Búsqueda predictiva",
    ],
  },
  {
    title: "Experiencia iOS Nativa",
    description:
      "Diseño cuidadosamente crafteado siguiendo Human Interface Guidelines con Flutter",
    icon: "phone",
    gradient: "from-neutral-800 to-neutral-800",
    details: [
      "Animaciones fluidas",
      "Componentes nativos",
      "Gestos intuitivos",
      "Adaptación dark/light",
    ],
  },
  {
    title: "Sistema de Gamificación",
    description:
      "Insignias automáticas que reconocen la participación activa y contribuciones de calidad",
    icon: "trophy",
    gradient: "from-neutral-800 to-neutral-800",
    details: [
      "Insignias dinámicas",
      "Logros por actividad",
      "Rankings locales",
      "Recompensas por calidad",
    ],
  },
  {
    title: "Arquitectura Escalable",
    description:
      "Backend híbrido Firebase + FastAPI optimizado para crecimiento y funcionalidades avanzadas",
    icon: "layers",
    gradient: "from-neutral-800 to-neutral-800",
    details: [
      "Microservicios",
      "NoSQL optimizado",
      "CDN para imágenes",
      "Auto-scaling",
    ],
  },
];

const platforms = ["iOS", "Android"];
import Icon from "../../components/atoms/Icon.astro";
---

<Layout title="MySpot | Descubrimiento de lugares" description="Proyecto de aplicación móvil para descubrir, calificar y compartir lugares locales.">
  <HeroTitle text="MYSPOT" />

  <!-- Hero Section -->
  <BaseSection className="text-center py-20">
    <div class="max-w-4xl mx-auto">

      <p
        class="text-xl text-neutral-300 max-w-3xl mx-auto leading-relaxed mb-8"
      >
        Plataforma social móvil que conecta usuarios con los mejores lugares de
        su ciudad. Descubre, califica y comparte experiencias con una comunidad
        local activa.
      </p>

      <!-- Tech Stack Pills -->
      <div class="flex flex-wrap justify-center gap-3 mb-8">
        <span
          class="px-4 py-2 bg-neutral-800 from-neutral-800 to-neutral-800 rounded-full text-sm font-semibold"
        >
          Flutter
        </span>
        <span
          class="px-4 py-2 bg-neutral-800 from-neutral-800 to-neutral-800 rounded-full text-sm font-semibold"
        >
          Firebase
        </span>
        <span
          class="px-4 py-2 bg-neutral-800 from-neutral-800 to-neutral-800 rounded-full text-sm font-semibold"
        >
          FastAPI
        </span>
        <span
          class="px-4 py-2 bg-neutral-800 from-neutral-800 to-neutral-800 rounded-full text-sm font-semibold"
        >
          MongoDB
        </span>
      </div>

      <div class="flex flex-wrap justify-center gap-3" aria-label="Plataformas objetivo">
        {platforms.map((platform) => (
          <span class="rounded-full border border-white/15 px-4 py-2 text-sm font-medium text-neutral-200">
            {platform}
          </span>
        ))}
      </div>
    </div>
  </BaseSection>

  <!-- Problem Solution Section -->
  <BaseSection>
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-16">
        <h2
          class="text-4xl font-bold mb-6 text-neutral-100"
        >
          Conectando Comunidades Locales
        </h2>
        <div
          class="w-24 h-1 bg-neutral-800 from-neutral-800 to-neutral-800 mx-auto mb-8"
        >
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="space-y-6">
          <div class="bg-white/5 border border-white/15 rounded-xl p-6">
            <h3 class="text-xl font-bold text-neutral-200 mb-3">
              <Icon name="search" size={22} /> Problema Identificado
            </h3>
            <ul class="text-neutral-300 space-y-2 text-sm">
              <li>• Información dispersa sobre lugares locales</li>
              <li>• Reseñas poco confiables en plataformas generales</li>
              <li>• Falta de comunidad local organizada</li>
              <li>• Descubrimiento limitado de nuevos lugares</li>
            </ul>
          </div>
        </div>

        <div class="space-y-6">
          <div
            class="bg-white/5 border border-white/15 rounded-xl p-6"
          >
            <h3 class="text-xl font-bold text-neutral-200 mb-3">
              <Icon name="sparkles" size={22} /> Solución MySpot
            </h3>
            <ul class="text-neutral-300 space-y-2 text-sm">
              <li>• Plataforma centralizada y especializada</li>
              <li>• Sistema de reputación con insignias</li>
              <li>• Comunidad verificada y activa</li>
              <li>• Descubrimiento inteligente por categorías</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </BaseSection>

  <!-- Tech Stack Section -->
  <BaseSection>
    <div class="text-center mb-16">
      <h2
        class="text-4xl font-bold mb-6 text-neutral-100"
      >
        Stack Tecnológico Moderno
      </h2>
      <div
        class="w-24 h-1 bg-neutral-800 from-neutral-800 to-neutral-800 mx-auto mb-8"
      >
      </div>
    </div>

    <div
      class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto mb-12"
    >
      {
        techStack.map((tech) => (
          <div class="group bg-neutral-800 from-neutral-800 to-neutral-900 rounded-2xl p-6 border border-neutral-700 hover:border-white/15 hover:scale-105 transition-all duration-300">
            <div class="text-4xl mb-4 text-center group-hover:scale-110 transition-transform">
              <Icon name={tech.icon} size={38} class="project-icon" />
            </div>
            <h3 class="text-lg font-bold text-center mb-2 text-white">
              {tech.name}
            </h3>
            <p class="text-neutral-400 text-sm text-center">
              {tech.description}
            </p>
            <div
              class={`mt-4 h-1 rounded bg-neutral-800 ${tech.gradient} mx-auto w-0 group-hover:w-full transition-all duration-500`}
            />
          </div>
        ))
      }
    </div>

    <!-- Arquitectura detallada -->
    <div
      class="bg-neutral-800 from-neutral-800/50 to-neutral-900/50 rounded-2xl p-8 border border-neutral-700"
    >
      <h3 class="text-2xl font-bold text-center mb-8 text-neutral-200">
        Arquitectura Híbrida
      </h3>
      <div class="grid md:grid-cols-3 gap-8 text-center">
        <div>
          <h4
            class="font-semibold text-white mb-3 flex items-center justify-center"
          >
            <span class="text-2xl mr-2"><Icon name="phone" size={22} /></span>
            Frontend Móvil
          </h4>
          <div class="text-neutral-300 space-y-1 text-sm">
            <p>Flutter con diseño iOS nativo</p>
            <p>Figma para prototipado</p>
            <p>Gestión de estado avanzada</p>
            <p>Animaciones fluidas</p>
          </div>
        </div>
        <div>
          <h4
            class="font-semibold text-white mb-3 flex items-center justify-center"
          >
            <span class="text-2xl mr-2"><Icon name="sparkles" size={22} /></span>
            Backend Híbrido
          </h4>
          <div class="text-neutral-300 space-y-1 text-sm">
            <p>Firebase para Auth y Realtime</p>
            <p>FastAPI para lógica compleja</p>
            <p>MongoDB para datos NoSQL</p>
            <p>Supabase Storage para media</p>
          </div>
        </div>
        <div>
          <h4
            class="font-semibold text-white mb-3 flex items-center justify-center"
          >
            <span class="text-2xl mr-2"><Icon name="wrench" size={22} /></span>
            DevOps & Tools
          </h4>
          <div class="text-neutral-300 space-y-1 text-sm">
            <p>Repositorio privado</p>
            <p>Gestión de tareas por usuario</p>
            <p>CI/CD para deployment</p>
            <p>Monitoring y analytics</p>
          </div>
        </div>
      </div>
    </div>
  </BaseSection>

  <!-- Features Section -->
  <BaseSection>
    <div class="text-center mb-16">
      <h2
        class="text-4xl font-bold mb-6 text-neutral-100"
      >
        Características Principales
      </h2>
      <div
        class="w-24 h-1 bg-neutral-800 from-neutral-800 to-neutral-800 mx-auto mb-8"
      >
      </div>
    </div>

    <div class="grid lg:grid-cols-2 gap-8 max-w-6xl mx-auto">
      {
        features.map((feature, index) => (
          <div class="group relative bg-neutral-800 from-neutral-800 to-neutral-900 rounded-2xl p-8 border border-neutral-700 hover:scale-105 transition-all duration-300 overflow-hidden">
            {/* Background glow effect */}
            <div
              class={`absolute inset-0 bg-neutral-800 ${feature.gradient} opacity-0 group-hover:opacity-10 transition-opacity duration-300`}
            />

            <div class="relative z-10">
              <div class="flex items-start space-x-4 mb-6">
                <div class="text-4xl group-hover:scale-110 transition-transform">
                  <Icon name={feature.icon} size={38} class="project-icon" />
                </div>
                <div class="flex-1">
                  <h3 class="text-xl font-bold mb-3 text-white group-hover:text-neutral-200 transition-colors">
                    {feature.title}
                  </h3>
                  <p class="text-neutral-300 leading-relaxed mb-4">
                    {feature.description}
                  </p>
                </div>
              </div>

              {/* Feature details */}
              <div class="grid grid-cols-2 gap-2">
                {feature.details.map((detail) => (
                  <div class="flex items-center space-x-2 text-sm text-neutral-400">
                    <div class="w-1.5 h-1.5 bg-neutral-700 rounded-full" />
                    <span>{detail}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </BaseSection>

  <!-- User Flow Section -->
  <BaseSection>
    <div class="text-center mb-16">
      <h2
        class="text-4xl font-bold mb-6 text-neutral-100"
      >
        Experiencia de Usuario
      </h2>
      <div
        class="w-24 h-1 bg-neutral-800 from-neutral-800 to-neutral-800 mx-auto mb-8"
      >
      </div>
    </div>

    <div class="max-w-5xl mx-auto">
      <div class="relative">
        <!-- Timeline line móvil -->
        <div
          class="absolute left-8 top-0 bottom-0 w-0.5 bg-neutral-800 from-neutral-800 to-neutral-800 md:hidden"
        >
        </div>
        <!-- Timeline line desktop -->
        <div
          class="hidden md:block absolute left-1/2 transform -translate-x-px h-full w-0.5 bg-neutral-800 from-neutral-800 to-neutral-800"
        >
        </div>

        <div class="space-y-12">
          <!-- Paso 1 -->
          <div class="flex items-center md:justify-between">
            <div
              class="flex md:hidden absolute left-6 w-4 h-4 bg-neutral-700 rounded-full border-4 border-neutral-950"
            >
            </div>
            <div
              class="w-[calc(100%_-_3rem)] md:w-5/12 ml-12 md:ml-0 bg-neutral-800 rounded-xl p-6 border border-neutral-700 hover:border-white/15 transition-colors"
            >
              <div class="flex items-center space-x-3 mb-3">
                <span class="text-2xl"><Icon name="rocket" size={22} /></span>
                <h3 class="font-bold text-lg text-neutral-200">
                  Registro Rápido
                </h3>
              </div>
              <p class="text-neutral-300 text-sm">
                Login con Google/Apple en segundos. Sin formularios complejos,
                directo a explorar.
              </p>
            </div>
            <div class="hidden md:block w-2/12 text-center">
              <div
                class="w-8 h-8 bg-neutral-700 rounded-full mx-auto flex items-center justify-center text-white font-bold"
              >
                1
              </div>
            </div>
            <div class="hidden md:block md:w-5/12"></div>
          </div>

          <!-- Paso 2 -->
          <div class="flex items-center md:justify-between">
            <div class="hidden md:block md:w-5/12"></div>
            <div class="hidden md:block w-2/12 text-center">
              <div
                class="w-8 h-8 bg-neutral-700 rounded-full mx-auto flex items-center justify-center text-white font-bold"
              >
                2
              </div>
            </div>
            <div
              class="flex md:hidden absolute left-6 w-4 h-4 bg-neutral-700 rounded-full border-4 border-neutral-950"
            >
            </div>
            <div
              class="w-[calc(100%_-_3rem)] md:w-5/12 ml-12 md:ml-0 bg-neutral-800 rounded-xl p-6 border border-neutral-700 hover:border-white/15 transition-colors"
            >
              <div class="flex items-center space-x-3 mb-3">
                <span class="text-2xl"><Icon name="map" size={22} /></span>
                <h3 class="font-bold text-lg text-neutral-200">
                  Explorar y Descubrir
                </h3>
              </div>
              <p class="text-neutral-300 text-sm">
                Navega por categorías, descubre lugares cercanos y lee reseñas
                auténticas de la comunidad.
              </p>
            </div>
          </div>

          <!-- Paso 3 -->
          <div class="flex items-center md:justify-between">
            <div
              class="flex md:hidden absolute left-6 w-4 h-4 bg-neutral-700 rounded-full border-4 border-neutral-950"
            >
            </div>
            <div
              class="w-[calc(100%_-_3rem)] md:w-5/12 ml-12 md:ml-0 bg-neutral-800 rounded-xl p-6 border border-neutral-700 hover:border-white/15 transition-colors"
            >
              <div class="flex items-center space-x-3 mb-3">
                <span class="text-2xl"><Icon name="message" size={22} /></span>
                <h3 class="font-bold text-lg text-neutral-200">
                  Participar y Calificar
                </h3>
              </div>
              <p class="text-neutral-300 text-sm">
                Comparte tu experiencia, sube fotos, califica lugares y
                participa en discusiones tipo red social.
              </p>
            </div>
            <div class="hidden md:block w-2/12 text-center">
              <div
                class="w-8 h-8 bg-neutral-700 rounded-full mx-auto flex items-center justify-center text-white font-bold"
              >
                3
              </div>
            </div>
            <div class="hidden md:block md:w-5/12"></div>
          </div>

          <!-- Paso 4 -->
          <div class="flex items-center md:justify-between">
            <div class="hidden md:block md:w-5/12"></div>
            <div class="hidden md:block w-2/12 text-center">
              <div
                class="w-8 h-8 bg-neutral-700 rounded-full mx-auto flex items-center justify-center text-white font-bold"
              >
                4
              </div>
            </div>
            <div
              class="flex md:hidden absolute left-6 w-4 h-4 bg-neutral-700 rounded-full border-4 border-neutral-950"
            >
            </div>
            <div
              class="w-[calc(100%_-_3rem)] md:w-5/12 ml-12 md:ml-0 bg-neutral-800 rounded-xl p-6 border border-neutral-700 hover:border-white/15 transition-colors"
            >
              <div class="flex items-center space-x-3 mb-3">
                <span class="text-2xl"><Icon name="trophy" size={22} /></span>
                <h3 class="font-bold text-lg text-neutral-200">
                  Ganar Reconocimiento
                </h3>
              </div>
              <p class="text-neutral-300 text-sm">
                Obtén insignias por tu participación activa y conviértete en un
                referente local de confianza.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </BaseSection>

  <!-- Screenshots/Gallery Section -->
  <BaseSection>
    <div class="text-center mb-16">
      <h2
        class="text-4xl font-bold mb-6 text-neutral-100"
      >
        Capturas de Pantalla
      </h2>
      <div
        class="w-24 h-1 bg-neutral-800 from-neutral-800 to-neutral-800 mx-auto mb-8"
      >
      </div>
      <p class="text-neutral-300 max-w-2xl mx-auto">
        Capturas del funcionamiento actual de la aplicación en iOS.
      </p>
    </div>

    <GalleryComponent images={screenshots} label="Pantallas de la aplicación MySpot" />
  </BaseSection>

  <BaseSection className="text-center">
    <div class="max-w-3xl mx-auto">
          <h2 class="text-3xl font-bold mb-4">Pantallas de MySpot</h2>
      <p class="text-neutral-300 mb-8">
        Recorrido visual por las principales pantallas de la aplicación móvil.
      </p>
    </div>
  </BaseSection>
</Layout>
