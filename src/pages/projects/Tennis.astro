---
import Layout from "../../layouts/Layout.astro";
import BaseSection from "../../components/atoms/BaseSection.astro";
const base = import.meta.env.BASE_URL;
const photo = `${base}images/intereses/tennis2.webp`;
---

<Layout title="Tenis | Historia personal de César Enríquez" description="La historia de César Enríquez en el tenis universitario y su campeonato en 2024.">
  <section class="tennis-hero" aria-labelledby="tennis-title">
    <div class="tennis-hero__inner">
      <a href={`${base}#intereses`}>← Volver a intereses</a>
      <h1 id="tennis-title">Tenis</h1>
      <p>Un espacio para competir, aprender y desconectarme del código.</p>
    </div>
  </section>
  <BaseSection>
    <div class="tennis-story">
      <img src={photo} alt="Cancha de tenis al atardecer" width="1200" height="800" />
      <div>
        <p class="tennis-label">Fuera del código</p>
        <h2>La cancha también enseña</h2>
        <p>El tenis es uno de mis intereses principales. Fui campeón de tenis de mi universidad en 2024 y sigo jugando por el gusto de competir y compartir el deporte.</p>
      </div>
    </div>
  </BaseSection>
</Layout>

<style>
  .tennis-hero { min-height: min(66svh, 48rem); display: flex; align-items: end; padding: 8rem var(--page-gutter) clamp(3rem, 7vw, 6rem); background: var(--bg); }
  .tennis-hero__inner { width: min(100%, var(--content-width)); margin: 0 auto; }
  .tennis-hero a { display: inline-flex; min-height: 2.75rem; align-items: center; margin-bottom: 2.5rem; color: var(--muted); font-size: .8rem; text-decoration: none; }
  .tennis-hero a:hover { color: var(--text); }
  .tennis-hero h1 { margin: 0; color: var(--text); font-size: clamp(4rem, 13vw, 10rem); line-height: .85; letter-spacing: -.08em; }
  .tennis-hero p { max-width: 35rem; margin: 1.5rem 0 0; color: var(--muted); font-size: 1.05rem; }
  .tennis-story { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 5rem); align-items: center; }
  .tennis-story img { width: 100%; max-height: 34rem; object-fit: cover; border-radius: var(--radius); }
  .tennis-label { margin: 0 0 .7rem; color: var(--muted); font-size: .8rem; }
  .tennis-story h2 { margin: 0 0 1rem; font-size: clamp(2rem, 4vw, 3.5rem); line-height: 1; letter-spacing: -.06em; }
  .tennis-story p:last-child { max-width: 38rem; margin: 0; color: var(--muted); }
  @media (max-width: 720px) { .tennis-story { grid-template-columns: 1fr; } }
</style>
