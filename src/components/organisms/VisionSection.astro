---
---

<section id="vision" class="vision-section">
  <div class="vision-inner">
    <p class="vision-label">Cómo trabajo</p>
    <blockquote class="vision-quote">
      Entiendo el sistema completo: datos, experiencia y operación.
    </blockquote>
    <ul class="vision-focus" aria-label="Áreas de trabajo">
      <li>Producto digital</li>
      <li>Sistemas de negocio</li>
      <li>Aplicaciones móviles</li>
    </ul>
  </div>
</section>

<style>
  .vision-section { padding: clamp(5rem, 10vw, 8rem) var(--page-gutter); background: var(--surface); }
  .vision-inner { width: min(100%, var(--content-width)); margin: 0 auto; }
  .vision-label { margin: 0 0 1.2rem; color: var(--muted); font-size: .78rem; }
  .vision-quote { max-width: 19ch; margin: 0; color: var(--text); font: 600 clamp(2rem, 5.5vw, 5rem)/1.05 Syne, sans-serif; letter-spacing: -.065em; }
  .vision-focus { display: flex; flex-wrap: wrap; gap: .6rem 1.5rem; margin: 2rem 0 0; padding: 0; list-style: none; color: var(--muted); font-size: .8rem; }
  @media (max-width: 560px) { .vision-quote { max-width: 15ch; } }
</style>
