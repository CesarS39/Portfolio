---
import ProjectCard from "../molecules/ProjectCard.astro";

interface Project {
  title: string;
  description: string;
  image: string;
  repo?: string | boolean;
  demo?: string;
  link?: string;
  techStack?: string[];
  featured?: boolean;
}

const { projects } = Astro.props as { projects: Project[] };
---

<section id="projects" class="projects-section reveal-section">
  <div class="projects-inner">
    <div class="projects-heading">
      <div>
        <p class="projects-label">Trabajo seleccionado</p>
        <h2>Proyectos</h2>
      </div>
      <p class="projects-intro">Productos y sistemas que conectan necesidades reales con software útil.</p>
    </div>
    <div class="projects-grid">
      {projects.map((project) => (
        <ProjectCard
          title={project.title}
          description={project.description}
          image={project.image}
          repo={project.repo && project.repo !== false ? String(project.repo) : undefined}
          demo={project.demo}
          link={project.link}
          techStack={project.techStack}
          featured={project.featured}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .projects-section { padding: clamp(5rem, 10vw, 9rem) var(--page-gutter); background: var(--bg); }
  .projects-inner { width: min(100%, var(--content-width)); margin: 0 auto; }
  .projects-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2.5rem; }
  .projects-label { margin: 0 0 .7rem; color: var(--muted); font-size: .78rem; }
  .projects-heading h2 { margin: 0; font-size: clamp(2.3rem, 5vw, 4rem); line-height: 1; letter-spacing: -.065em; }
  .projects-intro { max-width: 25rem; margin: 0; color: var(--muted); font-size: .95rem; }
  .projects-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.1rem; }
  @media (max-width: 680px) {
    .projects-heading { align-items: flex-start; flex-direction: column; gap: 1rem; }
    .projects-grid { grid-template-columns: 1fr; gap: .85rem; }
  }
</style>
